        "\n",
        "        # Run regression\n",
        "        y = df_clean[y_var]\n",
        "        X = df_clean[esg_log + control_vars]\n",
        "        X = pd.concat([pd.Series(1, index=X.index, name='const'), X], axis=1)\n",
        "\n",
        "        try:\n",
        "            model = PanelOLS(y, X, entity_effects=False, time_effects=False)\n",
        "            results = model.fit(cov_type='robust')\n",
        "\n",
        "            # Store results\n",
        "            key = f\"log_{'lagged' if use_lagged_esg else 'current'}_{y_var}\"\n",
        "            self.results[key] = {\n",
        "                'results': results,\n",
