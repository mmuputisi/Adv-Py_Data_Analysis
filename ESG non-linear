        "# standalone_nonlinear_model.py\n",
        "\"\"\"\n",
        "Standalone Non-Linear Effects Model Analysis\n",
        "Focus: Quadratic, threshold, and other non-linear specifications\n",
        "\"\"\"\n",
        "\n",
        "# ============================================================================\n",
        "# SETUP AND IMPORTS\n",
        "# ============================================================================\n",
        "from google.colab import drive\n",
        "drive.mount('/content/drive')\n",
        "\n",
        "!pip install -q linearmodels pandas numpy matplotlib seaborn statsmodels scikit-learn\n",
        "\n",
        "import os\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "from linearmodels.panel import PanelOLS\n",
        "import statsmodels.api as sm\n",
        "from scipy import stats\n",
        "import warnings\n",
        "warnings.filterwarnings('ignore')\n",
        "\n",
        "# ============================================================================\n",
        "# CONFIGURATION\n",
        "# ============================================================================\n",
        "class Config:\n",
        "    \"\"\"Configuration for non-linear effects analysis\"\"\"\n",
        "    PROJECT_DIR = '/content/drive/MyDrive/Colab Notebooks/FTSE Data'\n",
        "    DATA_PATH = os.path.join(PROJECT_DIR, 'FTSE data.xlsx')\n",
        "    OUTPUT_DIR = os.path.join(PROJECT_DIR, 'nonlinear_effects_outputs')\n",
        "\n",
        "    # Model settings\n",
        "    ESG_COMPONENTS = ['E', 'S', 'G']\n",
        "    CONTROL_VARS = ['ROA', 'Size', 'Leverage']\n",
        "\n",
        "    # Consumer Staples firms\n",
        "    CONSUMER_STAPLES_FIRMS = [\n",
        "        'Associated British Foods', 'British American Tobacco', 'Coca Cola HBC AG',\n",
        "        'Diageo', 'J. Sainsbury', 'Reckitt Benckiser', 'Tesco', 'Unilever', 'Haleon Plc'\n",
        "    ]\n",
        "\n",
        "    # Non-linear specifications\n",
        "    THRESHOLD_QUANTILES = [0.25, 0.5, 0.75, 0.9]  # For threshold effects\n",
        "    TRANSFORMATIONS = ['quadratic', 'cubic', 'log', 'sqrt', 'inverse', 'threshold']\n",
        "\n",
        "    # Output settings\n",
        "    CREATE_PLOTS = True\n",
        "    SAVE_RESULTS = True\n",
        "\n",
        "# ============================================================================\n",
        "# DATA LOADER\n",
        "# ============================================================================\n",
        "class DataLoader:\n",
        "    \"\"\"Load and prepare data for non-linear analysis\"\"\"\n",
        "\n",
        "    def __init__(self, config):\n",
        "        self.config = config\n",
        "        self.df = None\n",
        "        self.df_cs = None\n",
        "        self.df_all = None\n",
        "\n",
        "    def load_and_prepare_data(self):\n",
        "        \"\"\"Load data with basic transformations\"\"\"\n",
        "        print(\"Loading and preparing data...\")\n",
        "\n",
        "        # Load data\n",
        "        self.df = pd.read_excel(self.config.DATA_PATH)\n",
        "        self.df = self.df.set_index(['Firm', 'Year']).sort_index()\n",
        "        self.df = self.df.rename(columns={\"Tobin's Q\": \"Tobin_Q\"})\n",
        "\n",
        "        # Basic transformations\n",
        "        self.df['Size'] = np.log(self.df['Total Assets'])\n",
        "        self.df['Leverage'] = self.df['Total Liabilities'] / self.df['Total Assets']\n",
        "        self.df['Tobin_Q_log'] = np.log(self.df['Tobin_Q'] + 0.001)\n",
        "\n",
        "        # Create lagged ESG variables\n",
        "        self.df['E_lag'] = self.df.groupby(level=0)['E'].shift(1)\n",
        "        self.df['S_lag'] = self.df.groupby(level=0)['S'].shift(1)\n",
        "        self.df['G_lag'] = self.df.groupby(level=0)['G'].shift(1)\n",
        "\n",
        "        # Create lagged controls\n",
        "        self.df['ROA_lag'] = self.df.groupby(level=0)['ROA'].shift(1)\n",
        "        self.df['Size_lag'] = self.df.groupby(level=0)['Size'].shift(1)\n",
        "        self.df['Leverage_lag'] = self.df.groupby(level=0)['Leverage'].shift(1)\n",
        "\n",
        "        # Create sector variable\n",
        "        sectors = []\n",
        "        for firm in self.df.index.get_level_values(0):\n",
        "            if firm in self.config.CONSUMER_STAPLES_FIRMS:\n",
        "                sectors.append('Consumer Staples')\n",
        "            else:\n",
        "                sectors.append('Other')\n",
        "\n",
        "        self.df['Sector'] = sectors\n",
        "        self.df['ConsumerStaples'] = (self.df['Sector'] == 'Consumer Staples').astype(int)\n",
        "\n",
        "        # Create datasets\n",
        "        self.df_cs = self.df[self.df['ConsumerStaples'] == 1].copy()\n",
        "        self.df_all = self.df.copy()\n",
        "\n",
        "        print(f\"✓ Loaded {len(self.df)} total observations\")\n",
        "        print(f\"✓ Consumer Staples: {len(self.df_cs)} observations\")\n",
        "        print(f\"✓ Other sectors: {len(self.df) - len(self.df_cs)} observations\")\n",
        "\n",
        "        return self.df, self.df_cs, self.df_all\n",
        "\n",
        "    def create_nonlinear_transformations(self, df, use_lagged=True):\n",
        "        \"\"\"\n",
        "        Create all non-linear transformations for ESG variables\n",
        "\n",
        "        Parameters:\n",
        "        -----------\n",
        "        df : DataFrame\n",
        "            Input dataframe\n",
        "        use_lagged : bool\n",
        "            Whether to use lagged ESG variables (recommended: True)\n",
        "        \"\"\"\n",
        "        df_copy = df.copy()\n",
        "\n",
        "        prefix = '_lag' if use_lagged else ''\n",
        "\n",
        "        print(f\"Creating non-linear transformations for ESG{prefix}...\")\n",
        "\n",
        "        # 1. Quadratic terms\n",
        "        for component in self.config.ESG_COMPONENTS:\n",
        "            var = f'{component}{prefix}'\n",
        "            if var in df_copy.columns:\n",
        "                df_copy[f'{var}_sq'] = df_copy[var] ** 2\n",
        "                print(f\"  ✓ Quadratic: {var}_sq = ({var})²\")\n",
        "\n",
        "        # 2. Cubic terms\n",
        "        for component in self.config.ESG_COMPONENTS:\n",
        "            var = f'{component}{prefix}'\n",
        "            if var in df_copy.columns:\n",
        "                df_copy[f'{var}_cube'] = df_copy[var] ** 3\n",
        "                print(f\"  ✓ Cubic: {var}_cube = ({var})³\")\n",
        "\n",
        "        # 3. Logarithmic transformations (with small constant to avoid log(0))\n",
        "        for component in self.config.ESG_COMPONENTS:\n",
        "            var = f'{component}{prefix}'\n",
        "            if var in df_copy.columns:\n",
        "                min_val = df_copy[var].min()\n",
        "                constant = 1 - min_val if min_val < 1 else 0.001\n",
        "                df_copy[f'log_{var}'] = np.log(df_copy[var] + constant)\n",
        "                print(f\"  ✓ Logarithmic: log_{var} = ln({var} + {constant:.3f})\")\n",
        "\n",
        "        # 4. Square root transformations\n",
        "        for component in self.config.ESG_COMPONENTS:\n",
        "            var = f'{component}{prefix}'\n",
        "            if var in df_copy.columns:\n",
        "                # Shift to ensure positive values\n",
        "                min_val = df_copy[var].min()\n",
        "                shift = -min_val + 0.001 if min_val < 0 else 0\n",
        "                df_copy[f'sqrt_{var}'] = np.sqrt(df_copy[var] + shift)\n",
        "                print(f\"  ✓ Square root: sqrt_{var} = √({var} + {shift:.3f})\")\n",
        "\n",
        "        # 5. Inverse transformations\n",
        "        for component in self.config.ESG_COMPONENTS:\n",
        "            var = f'{component}{prefix}'\n",
        "            if var in df_copy.columns:\n",
        "                # Avoid division by zero\n",
        "                df_copy[f'inv_{var}'] = 1 / (df_copy[var] + 0.001)\n",
        "                print(f\"  ✓ Inverse: inv_{var} = 1/({var} + 0.001)\")\n",
        "\n",
        "        # 6. Threshold dummies\n",
        "        for component in self.config.ESG_COMPONENTS:\n",
        "            var = f'{component}{prefix}'\n",
        "            if var in df_copy.columns:\n",
        "                for q in self.config.THRESHOLD_QUANTILES:\n",
        "                    try:\n",
        "                        threshold = df_copy[var].quantile(q)\n",
        "                        df_copy[f'{var}_above{q*100:.0f}'] = (df_copy[var] > threshold).astype(int)\n",
        "                        print(f\"  ✓ Threshold ({q*100:.0f}%): {var}_above{q*100:.0f} = 1 if {var} > {threshold:.2f}\")\n",
        "                    except:\n",
        "                        pass\n",
        "\n",
        "        # 7. Interaction terms between ESG components\n",
        "        if use_lagged:\n",
        "            components = ['E_lag', 'S_lag', 'G_lag']\n",
        "        else:\n",
        "            components = ['E', 'S', 'G']\n",
        "\n",
        "        for i in range(len(components)):\n",
        "            for j in range(i+1, len(components)):\n",
        "                var1, var2 = components[i], components[j]\n",
        "                if var1 in df_copy.columns and var2 in df_copy.columns:\n",
        "                    df_copy[f'{var1}_{var2}_interact'] = df_copy[var1] * df_copy[var2]\n",
        "                    print(f\"  ✓ Interaction: {var1}_{var2}_interact = {var1} × {var2}\")\n",
        "\n",
        "        print(f\"✓ Created {sum(['_sq' in col or '_cube' in col or 'log_' in col or\n",
        "                               'sqrt_' in col or 'inv_' in col or '_above' in col or\n",
        "                               '_interact' in col for col in df_copy.columns])} non-linear transformations\")\n",
        "\n",
        "        return df_copy\n",
        "\n",
        "# ============================================================================\n",
        "# NON-LINEAR MODEL ANALYZER\n",
        "# ============================================================================\n",
        "class NonlinearEffectsAnalyzer:\n",
        "    \"\"\"Analyze non-linear effects of ESG on Tobin's Q\"\"\"\n",
