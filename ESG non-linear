        "    def _select_best_model(self, df, y_var, control_vars, use_lagged_esg):\n",
        "        \"\"\"Select best non-linear model using AIC/BIC\"\"\"\n",
        "        print(f\"\\nModel selection criteria:\")\n",
        "        print(\"-\" * 60)\n",
        "\n",
        "        # Get models for this specification\n",
        "        model_keys = [k for k in self.results.keys() if y_var in k]\n",
        "\n",
        "        if not model_keys:\n",
        "            print(\"No models to compare\")\n",
        "            return None\n",
        "\n",
        "        comparison_data = []\n",
        "\n",
        "        for key in model_keys:\n",
        "            model_info = self.results[key]\n",
        "            results = model_info['results']\n",
        "\n",
        "            # Calculate information criteria\n",
        "            n = results.nobs\n",
        "            k = len(results.params)\n",
        "            ssr = getattr(results, 'ssr', None)\n",
        "\n",
        "            if ssr is None:\n",
        "                # Estimate SSR from residuals\n",
        "                y_pred = results.predict().fitted_values\n",
        "                y_actual = results.model.dependent.dataframe.iloc[:, 0]\n",
        "                ssr = np.sum((y_actual - y_pred) ** 2)\n",
        "\n",
        "            aic = n * np.log(ssr/n) + 2 * k\n",
        "            bic = n * np.log(ssr/n) + k * np.log(n)\n",
        "\n",
        "            comparison_data.append({\n",
        "                'Model': model_info['type'],\n",
        "                'R²': results.rsquared,\n",
        "                'Adj_R²': results.rsquared_adj if hasattr(results, 'rsquared_adj') else results.rsquared,\n",
        "                'AIC': aic,\n",
        "                'BIC': bic,\n",
        "                'N': n,\n",
        "                'K': k,\n",
        "                'key': key\n",
        "            })\n",
        "\n",
        "            print(f\"{model_info['type'].replace('_', ' ').title():<20} \"\n",
        "                  f\"R²={results.rsquared:.4f}  AIC={aic:.1f}  BIC={bic:.1f}\")\n",
        "\n",
        "        # Create comparison DataFrame\n",
        "        comparison_df = pd.DataFrame(comparison_data)\n",
        "\n",
        "        # Find best models\n",
        "        best_aic = comparison_df.loc[comparison_df['AIC'].idxmin()]\n",
        "        best_bic = comparison_df.loc[comparison_df['BIC'].idxmin()]\n",
        "        best_r2 = comparison_df.loc[comparison_df['R²'].idxmax()]\n",
        "\n",
        "        print(f\"\\nBest by AIC: {best_aic['Model']} (AIC={best_aic['AIC']:.1f})\")\n",
        "        print(f\"Best by BIC: {best_bic['Model']} (BIC={best_bic['BIC']:.1f})\")\n",
        "        print(f\"Best by R²: {best_r2['Model']} (R²={best_r2['R²']:.4f})\")\n",
        "\n",
        "        # Recommend based on BIC (more conservative)\n",
        "        recommendation = best_bic['key']\n",
        "        print(f\"\\nRECOMMENDED MODEL: {self.results[recommendation]['type'].replace('_', ' ').title()}\")\n",
        "\n",
        "        return self.results[recommendation]\n",
