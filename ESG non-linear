        "\n",
        "            # Store results\n",
        "            key = f\"cubic_{'lagged' if use_lagged_esg else 'current'}_{y_var}\"\n",
        "            self.results[key] = {\n",
        "                'results': results,\n",
        "                'type': 'cubic',\n",
        "                'nobs': results.nobs,\n",
        "                'r2': results.rsquared,\n",
        "                'aic': self._calculate_aic(results),\n",
