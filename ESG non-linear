        "\n",
        "            return results\n",
        "\n",
        "        except Exception as e:\n",
        "            print(f\"  ✗ Error: {e}\")\n",
        "            return None\n",
        "\n",
        "    def _run_sqrt_model(self, df, y_var, control_vars, use_lagged_esg):\n",
        "        \"\"\"Run square root model: Y = β0 + β1·√X + controls\"\"\"\n",
        "        prefix = '_lag' if use_lagged_esg else ''\n",
        "\n",
        "        # Prepare variables\n",
        "        esg_sqrt = [f'sqrt_{c}{prefix}' for c in self.config.ESG_COMPONENTS]\n",
        "\n",
        "        all_vars = esg_sqrt + control_vars + [y_var]\n",
        "        df_clean = df.dropna(subset=all_vars)\n",
        "\n",
        "        if len(df_clean) < 10:\n",
        "            print(\"  ⚠ Insufficient data\")\n",
        "            return None\n",
        "\n",
        "        # Run regression\n",
        "        y = df_clean[y_var]\n",
        "        X = df_clean[esg_sqrt + control_vars]\n",
        "        X = pd.concat([pd.Series(1, index=X.index, name='const'), X], axis=1)\n",
        "\n",
        "        try:\n",
        "            model = PanelOLS(y, X, entity_effects=False, time_effects=False)\n",
        "            results = model.fit(cov_type='robust')\n",
        "\n",
        "            # Store results\n",
        "            key = f\"sqrt_{'lagged' if use_lagged_esg else 'current'}_{y_var}\"\n",
        "            self.results[key] = {\n",
        "                'results': results,\n",
        "                'type': 'square_root',\n",
        "                'nobs': results.nobs,\n",
        "                'r2': results.rsquared,\n",
        "                'aic': self._calculate_aic(results),\n",
        "                'bic': self._calculate_bic(results)\n",
        "            }\n",
        "\n",
        "            # Print results with equation\n",
        "            self._print_sqrt_results(results, y_var, use_lagged_esg, control_vars)\n",
        "\n",
        "            return results\n",
        "\n",
        "        except Exception as e:\n",
        "            print(f\"  ✗ Error: {e}\")\n",
        "            return None\n",
        "\n",
        "    def _run_threshold_models(self, df, y_var, control_vars, use_lagged_esg):\n",
        "        \"\"\"Run threshold models: Y = β0 + β1·1(X > threshold) + controls\"\"\"\n",
        "        prefix = '_lag' if use_lagged_esg else ''\n",
        "        threshold_results = {}\n",
        "\n",
        "        for q in self.config.THRESHOLD_QUANTILES:\n",
        "            # Prepare variables\n",
        "            threshold_vars = [f'{c}{prefix}_above{q*100:.0f}'\n",
        "                             for c in self.config.ESG_COMPONENTS]\n",
        "\n",
        "            all_vars = threshold_vars + control_vars + [y_var]\n",
        "            df_clean = df.dropna(subset=all_vars)\n",
        "\n",
        "            if len(df_clean) < 10:\n",
        "                continue\n",
        "\n",
        "            # Run regression\n",
        "            y = df_clean[y_var]\n",
        "            X = df_clean[threshold_vars + control_vars]\n",
        "            X = pd.concat([pd.Series(1, index=X.index, name='const'), X], axis=1)\n",
        "\n",
        "            try:\n",
        "                model = PanelOLS(y, X, entity_effects=False, time_effects=False)\n",
        "                results = model.fit(cov_type='robust')\n",
        "\n",
        "                # Store results\n",
        "                key = f\"threshold_{q*100:.0f}_{'lagged' if use_lagged_esg else 'current'}_{y_var}\"\n",
        "                self.results[key] = {\n",
        "                    'results': results,\n",
        "                    'type': f'threshold_{q*100:.0f}',\n",
        "                    'nobs': results.nobs,\n",
        "                    'r2': results.rsquared,\n",
        "                    'aic': self._calculate_aic(results),\n",
        "                    'bic': self._calculate_bic(results)\n",
        "                }\n",
        "\n",
        "                threshold_results[f'q{q}'] = results\n",
        "\n",
        "                # Print brief results\n",
        "                print(f\"  Threshold {q*100:.0f}%: R² = {results.rsquared:.4f}, N = {results.nobs}\")\n",
        "\n",
        "            except Exception as e:\n",
        "                print(f\"  ✗ Error for threshold {q}: {e}\")\n",
        "\n",
        "        # Print detailed results for best threshold\n",
        "        if threshold_results:\n",
        "            best_key = max(threshold_results.keys(),\n",
        "                          key=lambda k: threshold_results[k].rsquared)\n",
        "            best_results = threshold_results[best_key]\n",
        "            q_value = float(best_key.replace('q', ''))\n",
        "\n",
        "            self._print_threshold_results(best_results, y_var, use_lagged_esg,\n",
        "                                         control_vars, q_value)\n",
        "\n",
        "            # Plot threshold effects\n",
        "            if self.config.CREATE_PLOTS:\n",
        "                self._plot_threshold_effects(df, y_var, use_lagged_esg, q_value)\n",
        "\n",
        "        return threshold_results\n",
        "\n",
        "    def _run_interaction_model(self, df, y_var, control_vars, use_lagged_esg):\n",
        "        \"\"\"Run interaction model: Y = β0 + β1E + β2S + β3G + β4(E×S) + β5(E×G) + β6(S×G) + controls\"\"\"\n",
        "        prefix = '_lag' if use_lagged_esg else ''\n",
        "\n",
        "        # Prepare variables\n",
        "        esg_linear = [f'{c}{prefix}' for c in self.config.ESG_COMPONENTS]\n",
        "\n",
        "        # Create interaction terms if they don't exist\n",
        "        interactions = []\n",
        "        for i in range(len(esg_linear)):\n",
        "            for j in range(i+1, len(esg_linear)):\n",
        "                var1, var2 = esg_linear[i], esg_linear[j]\n",
        "                inter_var = f'{var1}_{var2}_interact'\n",
        "                if inter_var in df.columns:\n",
        "                    interactions.append(inter_var)\n",
        "                else:\n",
        "                    # Create interaction on the fly\n",
        "                    df[inter_var] = df[var1] * df[var2]\n",
        "                    interactions.append(inter_var)\n",
        "\n",
        "        all_vars = esg_linear + interactions + control_vars + [y_var]\n",
        "        df_clean = df.dropna(subset=all_vars)\n",
        "\n",
        "        if len(df_clean) < 10:\n",
        "            print(\"  ⚠ Insufficient data\")\n",
        "            return None\n",
        "\n",
        "        # Run regression\n",
        "        y = df_clean[y_var]\n",
        "        X = df_clean[esg_linear + interactions + control_vars]\n",
        "        X = pd.concat([pd.Series(1, index=X.index, name='const'), X], axis=1)\n",
        "\n",
        "        try:\n",
        "            model = PanelOLS(y, X, entity_effects=False, time_effects=False)\n",
        "            results = model.fit(cov_type='robust')\n",
        "\n",
        "            # Calculate marginal effects\n",
        "            marginal_effects = {}\n",
        "            for component in self.config.ESG_COMPONENTS:\n",
        "                var = f'{component}{prefix}'\n",
        "                if var in results.params:\n",
        "                    # Base effect\n",
        "                    base_effect = results.params[var]\n",
        "\n",
        "                    # Interaction effects (evaluated at mean of other variable)\n",
        "                    interaction_effect = 0\n",
        "                    for other_component in self.config.ESG_COMPONENTS:\n",
        "                        if other_component != component:\n",
        "                            other_var = f'{other_component}{prefix}'\n",
        "                            inter_var = f'{var}_{other_var}_interact'\n",
        "                            if inter_var in results.params:\n",
        "                                other_mean = df_clean[other_var].mean()\n",
        "                                interaction_effect += results.params[inter_var] * other_mean\n",
        "\n",
        "                    marginal_effects[component] = {\n",
        "                        'base_effect': base_effect,\n",
        "                        'interaction_effect': interaction_effect,\n",
        "                        'total_effect': base_effect + interaction_effect\n",
        "                    }\n",
        "\n",
        "            # Store results\n",
        "            key = f\"interaction_{'lagged' if use_lagged_esg else 'current'}_{y_var}\"\n",
        "            self.results[key] = {\n",
        "                'results': results,\n",
        "                'type': 'interaction',\n",
        "                'marginal_effects': marginal_effects,\n",
        "                'nobs': results.nobs,\n",
        "                'r2': results.rsquared,\n",
        "                'aic': self._calculate_aic(results),\n",
        "                'bic': self._calculate_bic(results)\n",
        "            }\n",
        "\n",
        "            # Print results with equation\n",
