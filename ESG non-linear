        "                control_effect = 0\n",
        "                for control in df.columns:\n",
        "                    if control in results.params and control not in ['const', linear_var, quad_var]:\n",
        "                        if control in df.columns:\n",
        "                            control_mean = df[control].mean()\n",
        "                            control_effect += results.params[control] * control_mean\n",
        "\n",
        "                # Generate predicted values\n",
        "                x_min = df[linear_var].min()\n",
        "                x_max = df[linear_var].max()\n",
        "                x_range = np.linspace(x_min, x_max, 100)\n",
        "\n",
        "                # Calculate predicted y\n",
        "                y_pred = beta0 + beta1 * x_range + beta2 * (x_range ** 2) + control_effect\n",
        "\n",
        "                # Calculate turning point\n",
        "                if beta2 != 0:\n",
        "                    turning_point = -beta1 / (2 * beta2)\n",
        "\n",
        "                    # Plot\n",
        "                    axes[idx].plot(x_range, y_pred, 'b-', linewidth=2, label='Quadratic fit')\n",
        "                    axes[idx].axvline(x=turning_point, color='r', linestyle='--',\n",
        "                                     alpha=0.7, label=f'Turning point: {turning_point:.2f}')\n",
        "\n",
        "                    # Add scatter of actual data\n",
        "                    axes[idx].scatter(df[linear_var], df[y_var], alpha=0.3, s=20,\n",
        "                                     color='gray', label='Actual data')\n",
        "\n",
        "                    axes[idx].set_xlabel(f'{component} Score', fontsize=12)\n",
        "                    axes[idx].set_ylabel(f'Predicted {y_var}', fontsize=12)\n",
        "                    axes[idx].set_title(f'{component}: {(\"U-shaped\" if beta2 > 0 else \"Inverted U-shaped\")}',\n",
        "                                       fontsize=14)\n",
        "                    axes[idx].legend()\n",
        "                    axes[idx].grid(True, alpha=0.3)\n",
        "                else:\n",
        "                    axes[idx].text(0.5, 0.5, 'No quadratic effect',\n",
        "                                  ha='center', va='center', transform=axes[idx].transAxes)\n",
        "            else:\n",
        "                axes[idx].text(0.5, 0.5, 'Insufficient data',\n",
        "                              ha='center', va='center', transform=axes[idx].transAxes)\n",
        "\n",
        "        plt.tight_layout()\n",
        "\n",
        "        # Save plot\n",
        "        os.makedirs(self.config.OUTPUT_DIR, exist_ok=True)\n",
        "        plt.savefig(os.path.join(self.config.OUTPUT_DIR,\n",
        "                                f'quadratic_effects_{y_var}.png'),\n",
        "                   dpi=300, bbox_inches='tight')\n",
        "        plt.show()\n",
        "\n",
        "    def _plot_threshold_effects(self, df, y_var, use_lagged_esg, quantile):\n",
        "        \"\"\"Create plots showing threshold effects\"\"\"\n",
        "        prefix = '_lag' if use_lagged_esg else ''\n",
        "\n",
        "        fig, axes = plt.subplots(1, 3, figsize=(18, 5))\n",
        "        fig.suptitle(f'Threshold Effects (Top {quantile*100:.0f}%)', fontsize=16, fontweight='bold')\n",
        "\n",
        "        for idx, component in enumerate(self.config.ESG_COMPONENTS):\n",
        "            var = f'{component}{prefix}'\n",
        "            thresh_var = f'{var}_above{quantile*100:.0f}'\n",
        "\n",
        "            if var in df.columns and thresh_var in df.columns:\n",
        "                # Calculate threshold\n",
        "                threshold = df[var].quantile(quantile)\n",
        "\n",
        "                # Create scatter plot with different colors for above/below threshold\n",
        "                below_thresh = df[df[thresh_var] == 0]\n",
        "                above_thresh = df[df[thresh_var] == 1]\n",
        "\n",
        "                axes[idx].scatter(below_thresh[var], below_thresh[y_var],\n",
        "                                 alpha=0.5, s=30, color='blue', label=f'Below {quantile*100:.0f}%')\n",
        "                axes[idx].scatter(above_thresh[var], above_thresh[y_var],\n",
        "                                 alpha=0.5, s=30, color='red', label=f'Above {quantile*100:.0f}%')\n",
        "\n",
        "                # Add vertical line at threshold\n",
        "                axes[idx].axvline(x=threshold, color='black', linestyle='--',\n",
        "                                 linewidth=2, alpha=0.7, label=f'Threshold: {threshold:.2f}')\n",
        "\n",
        "                # Fit separate regressions\n",
        "                try:\n",
        "                    # Below threshold\n",
        "                    if len(below_thresh) > 5:\n",
        "                        X_below = sm.add_constant(below_thresh[var])\n",
        "                        model_below = sm.OLS(below_thresh[y_var], X_below).fit()\n",
        "                        x_below = np.linspace(below_thresh[var].min(), threshold, 50)\n",
        "                        X_pred_below = sm.add_constant(x_below)\n",
        "                        y_pred_below = model_below.predict(X_pred_below)\n",
        "                        axes[idx].plot(x_below, y_pred_below, 'b-', linewidth=2,\n",
        "                                      label=f'Below: slope={model_below.params[var]:.4f}')\n",
        "\n",
        "                    # Above threshold\n",
        "                    if len(above_thresh) > 5:\n",
        "                        X_above = sm.add_constant(above_thresh[var])\n",
        "                        model_above = sm.OLS(above_thresh[y_var], X_above).fit()\n",
        "                        x_above = np.linspace(threshold, above_thresh[var].max(), 50)\n",
        "                        X_pred_above = sm.add_constant(x_above)\n",
        "                        y_pred_above = model_above.predict(X_pred_above)\n",
        "                        axes[idx].plot(x_above, y_pred_above, 'r-', linewidth=2,\n",
        "                                      label=f'Above: slope={model_above.params[var]:.4f}')\n",
        "\n",
        "                except:\n",
        "                    pass\n",
        "\n",
        "                axes[idx].set_xlabel(f'{component} Score', fontsize=12)\n",
        "                axes[idx].set_ylabel(y_var, fontsize=12)\n",
        "                axes[idx].set_title(f'{component} Threshold Effect', fontsize=14)\n",
        "                axes[idx].legend(fontsize=10)\n",
        "                axes[idx].grid(True, alpha=0.3)\n",
        "            else:\n",
        "                axes[idx].text(0.5, 0.5, 'Insufficient data',\n",
        "                              ha='center', va='center', transform=axes[idx].transAxes)\n",
        "\n",
        "        plt.tight_layout()\n",
        "\n",
        "        # Save plot\n",
        "        plt.savefig(os.path.join(self.config.OUTPUT_DIR,\n",
        "                                f'threshold_effects_{quantile*100:.0f}_{y_var}.png'),\n",
        "                   dpi=300, bbox_inches='tight')\n",
        "        plt.show()\n",
        "\n",
        "    # ============================================================================\n",
        "    # HELPER METHODS\n",
        "    # ============================================================================\n",
        "\n",
        "    def _calculate_aic(self, results):\n",
        "        \"\"\"Calculate Akaike Information Criterion\"\"\"\n",
        "        n = results.nobs\n",
        "        k = len(results.params)\n",
        "        ssr = getattr(results, 'ssr', None)\n",
        "\n",
        "        if ssr is None:\n",
        "            # Estimate SSR from residuals\n",
        "            y_pred = results.predict().fitted_values\n",
        "            y_actual = results.model.dependent.dataframe.iloc[:, 0]\n",
        "            ssr = np.sum((y_actual - y_pred) ** 2)\n",
        "\n",
        "        aic = n * np.log(ssr/n) + 2 * k\n",
        "        return aic\n",
        "\n",
        "    def _calculate_bic(self, results):\n",
        "        \"\"\"Calculate Bayesian Information Criterion\"\"\"\n",
        "        n = results.nobs\n",
        "        k = len(results.params)\n",
        "        ssr = getattr(results, 'ssr', None)\n",
        "\n",
        "        if ssr is None:\n",
        "            # Estimate SSR from residuals\n",
        "            y_pred = results.predict().fitted_values\n",
        "            y_actual = results.model.dependent.dataframe.iloc[:, 0]\n",
        "            ssr = np.sum((y_actual - y_pred) ** 2)\n",
        "\n",
        "        bic = n * np.log(ssr/n) + k * np.log(n)\n",
        "        return bic\n",
        "\n",
        "    def _get_significance_stars(self, pval):\n",
        "        \"\"\"Get significance stars for p-value\"\"\"\n",
        "        if pval < 0.01:\n",
        "            return \"***\"\n",
        "        elif pval < 0.05:\n",
        "            return \"**\"\n",
        "        elif pval < 0.10:\n",
        "            return \"*\"\n",
        "        else:\n",
        "            return \"\"\n",
        "\n",
        "    def _create_comparison_table(self):\n",
        "        \"\"\"Create comparison table of all non-linear models\"\"\"\n",
        "        if not self.results:\n",
        "            print(\"No results to compare\")\n",
        "            return\n",
        "\n",
        "        print(\"\\n\" + \"=\"*80)\n",
        "        print(\"COMPREHENSIVE MODEL COMPARISON\")\n",
        "        print(\"=\"*80)\n",
        "\n",
        "        comparison_data = []\n",
        "\n",
        "        for key, model_info in self.results.items():\n",
        "            results = model_info['results']\n",
        "\n",
        "            row = {\n",
        "                'Model': model_info['type'].replace('_', ' ').title(),\n",
        "                'Key': key,\n",
        "                'N': model_info['nobs'],\n",
        "                'R²': model_info['r2'],\n",
        "                'AIC': model_info.get('aic', np.nan),\n",
        "                'BIC': model_info.get('bic', np.nan),\n",
        "            }\n",
        "\n",
        "            # Add ESG coefficients\n",
        "            for component in self.config.ESG_COMPONENTS:\n",
        "                # Find component variable\n",
        "                component_vars = [v for v in results.params.index\n",
        "                                 if component in str(v) and 'const' not in str(v)]\n",
        "                if component_vars:\n",
        "                    # Take first relevant variable\n",
        "                    var = component_vars[0]\n",
        "                    if var in results.params:\n",
        "                        coeff = results.params[var]\n",
        "                        pval = results.pvalues.get(var, 1.0)\n",
        "                        sig = self._get_significance_stars(pval)\n",
        "                        row[f'{component}'] = f\"{coeff:.4f}{sig}\"\n",
        "\n",
        "            comparison_data.append(row)\n",
        "\n",
        "        # Create and display DataFrame\n",
        "        comparison_df = pd.DataFrame(comparison_data)\n",
        "\n",
        "        # Sort by R²\n",
        "        comparison_df = comparison_df.sort_values('R²', ascending=False)\n",
        "\n",
        "        print(\"\\nModel Performance Comparison:\")\n",
        "        print(\"-\" * 80)\n",
        "\n",
        "        # Display only key columns for readability\n",
        "        display_cols = ['Model', 'N', 'R²', 'AIC', 'BIC', 'E', 'S', 'G']\n",
        "        display_cols = [c for c in display_cols if c in comparison_df.columns]\n",
        "\n",
        "        print(comparison_df[display_cols].to_string(index=False))\n",
        "\n",
        "        # Save to CSV\n",
        "        if self.config.SAVE_RESULTS:\n",
        "            os.makedirs(self.config.OUTPUT_DIR, exist_ok=True)\n",
        "            csv_path = os.path.join(self.config.OUTPUT_DIR, 'nonlinear_models_comparison.csv')\n",
        "            comparison_df.to_csv(csv_path, index=False)\n",
        "            print(f\"\\n✓ Comparison table saved to: {csv_path}\")\n",
        "\n",
        "        return comparison_df\n",
        "\n",
