        "\n",
        "        # Run regression\n",
        "        y = df_clean[y_var]\n",
        "        X = df_clean[esg_linear + esg_quadratic + esg_cubic + control_vars]\n",
        "        X = pd.concat([pd.Series(1, index=X.index, name='const'), X], axis=1)\n",
        "\n",
        "        try:\n",
        "            model = PanelOLS(y, X, entity_effects=False, time_effects=False)\n",
