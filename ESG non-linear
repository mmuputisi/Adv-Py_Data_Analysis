        "\n",
        "            return results\n",
        "\n",
        "        except Exception as e:\n",
        "            print(f\"  ✗ Error: {e}\")\n",
        "            return None\n",
        "\n",
        "    def _run_logarithmic_model(self, df, y_var, control_vars, use_lagged_esg):\n",
        "        \"\"\"Run logarithmic model: Y = β0 + β1·ln(X) + controls\"\"\"\n",
        "        prefix = '_lag' if use_lagged_esg else ''\n",
        "\n",
        "        # Prepare variables\n",
        "        esg_log = [f'log_{c}{prefix}' for c in self.config.ESG_COMPONENTS]\n",
        "\n",
        "        all_vars = esg_log + control_vars + [y_var]\n",
        "        df_clean = df.dropna(subset=all_vars)\n",
        "\n",
