        "        }\n",
        "\n",
        "    def _run_quadratic_model(self, df, y_var, control_vars, use_lagged_esg):\n",
        "        \"\"\"Run quadratic model: Y = β0 + β1X + β2X² + controls\"\"\"\n",
        "        prefix = '_lag' if use_lagged_esg else ''\n",
        "\n",
        "        # Prepare variables\n",
        "        esg_linear = [f'{c}{prefix}' for c in self.config.ESG_COMPONENTS]\n",
        "        esg_quadratic = [f'{c}{prefix}_sq' for c in self.config.ESG_COMPONENTS]\n",
        "\n",
        "        all_vars = esg_linear + esg_quadratic + control_vars + [y_var]\n",
        "        df_clean = df.dropna(subset=all_vars)\n",
        "\n",
        "        if len(df_clean) < 10:\n",
        "            print(\"  ⚠ Insufficient data\")\n",
        "            return None\n",
        "\n",
        "        # Run regression\n",
        "        y = df_clean[y_var]\n",
        "        X = df_clean[esg_linear + esg_quadratic + control_vars]\n",
        "        X = pd.concat([pd.Series(1, index=X.index, name='const'), X], axis=1)\n",
        "\n",
        "        try:\n",
        "            model = PanelOLS(y, X, entity_effects=False, time_effects=False)\n",
        "            results = model.fit(cov_type='robust')\n",
        "\n",
        "            # Calculate turning points\n",
        "            turning_points = {}\n",
        "            for component in self.config.ESG_COMPONENTS:\n",
        "                linear_var = f'{component}{prefix}'\n",
        "                quad_var = f'{component}{prefix}_sq'\n",
        "\n",
        "                if linear_var in results.params and quad_var in results.params:\n",
        "                    beta1 = results.params[linear_var]\n",
        "                    beta2 = results.params[quad_var]\n",
        "\n",
        "                    if beta2 != 0:\n",
        "                        turning_point = -beta1 / (2 * beta2)\n",
        "                        if turning_point >= df_clean[linear_var].min() and turning_point <= df_clean[linear_var].max():\n",
        "                            shape = \"U-shaped\" if beta2 > 0 else \"Inverted U-shaped\"\n",
        "                            turning_points[component] = {\n",
        "                                'turning_point': turning_point,\n",
        "                                'shape': shape,\n",
        "                                'beta1': beta1,\n",
        "                                'beta2': beta2\n",
        "                            }\n",
        "\n",
        "            # Store results\n",
        "            key = f\"quadratic_{'lagged' if use_lagged_esg else 'current'}_{y_var}\"\n",
        "            self.results[key] = {\n",
        "                'results': results,\n",
        "                'type': 'quadratic',\n",
        "                'turning_points': turning_points,\n",
        "                'nobs': results.nobs,\n",
        "                'r2': results.rsquared,\n",
        "                'aic': self._calculate_aic(results),\n",
        "                'bic': self._calculate_bic(results)\n",
        "            }\n",
        "\n",
        "            # Print results with equation\n",
        "            self._print_quadratic_results(results, turning_points, y_var,\n",
        "                                         use_lagged_esg, control_vars)\n",
        "\n",
        "            # Create quadratic effect plots\n",
        "            if self.config.CREATE_PLOTS:\n",
        "                self._plot_quadratic_effects(df_clean, results, y_var,\n",
        "                                           use_lagged_esg)\n",
        "\n",
        "            return results\n",
        "\n",
        "        except Exception as e:\n",
        "            print(f\"  ✗ Error: {e}\")\n",
        "            return None\n",
        "\n",
        "    def _run_cubic_model(self, df, y_var, control_vars, use_lagged_esg):\n",
        "        \"\"\"Run cubic model: Y = β0 + β1X + β2X² + β3X³ + controls\"\"\"\n",
        "        prefix = '_lag' if use_lagged_esg else ''\n",
        "\n",
        "        # Prepare variables\n",
        "        esg_linear = [f'{c}{prefix}' for c in self.config.ESG_COMPONENTS]\n",
        "        esg_quadratic = [f'{c}{prefix}_sq' for c in self.config.ESG_COMPONENTS]\n",
        "        esg_cubic = [f'{c}{prefix}_cube' for c in self.config.ESG_COMPONENTS]\n",
        "\n",
        "        all_vars = esg_linear + esg_quadratic + esg_cubic + control_vars + [y_var]\n",
        "        df_clean = df.dropna(subset=all_vars)\n",
        "\n",
        "        if len(df_clean) < 10:\n",
