        "\n",
        "        # Get all model names from both sets\n",
        "        all_models = set(list(results_orig.keys()) + list(results_trans.keys()))\n",
        "\n",
        "        for model_key in sorted(all_models):\n",
        "            # Original results\n",
        "            orig_data = results_orig.get(model_key)\n",
        "            trans_data = results_trans.get(model_key)\n",
        "\n",
        "            if orig_data or trans_data:\n",
        "                # Model name (clean up)\n",
        "                if orig_data:\n",
        "                    model_name = orig_data['model_name'].replace(' (All)', '').replace(' (CS)', '')\n",
        "                elif trans_data:\n",
        "                    model_name = trans_data['model_name'].replace(' (All)', '').replace(' (CS)', '')\n",
        "                else:\n",
        "                    model_name = model_key.replace('_', ' ').title()\n",
        "\n",
        "                # Extract coefficients\n",
        "                if orig_data:\n",
        "                    orig_r2 = orig_data['r2']\n",
        "                    orig_social = self._extract_social_coeff(orig_data['results'])\n",
        "                    orig_n = orig_data['nobs']\n",
        "                else:\n",
        "                    orig_r2 = orig_social = orig_n = np.nan\n",
        "\n",
        "                if trans_data:\n",
        "                    trans_r2 = trans_data['r2']\n",
        "                    trans_social = self._extract_social_coeff(trans_data['results'])\n",
        "                    trans_n = trans_data['nobs']\n",
        "                else:\n",
        "                    trans_r2 = trans_social = trans_n = np.nan\n",
        "\n",
        "                # Calculate R² difference\n",
        "                if not np.isnan(orig_r2) and not np.isnan(trans_r2):\n",
        "                    r2_diff = trans_r2 - orig_r2\n",
        "                    r2_diff_str = f\"{r2_diff:+.4f}\"\n",
        "                else:\n",
        "                    r2_diff_str = \"N/A\"\n",
        "\n",
        "                table_data.append({\n",
        "                    'Model': model_name,\n",
        "                    'Original_R2': f\"{orig_r2:.4f}\" if not np.isnan(orig_r2) else \"N/A\",\n",
        "                    'Trans_R2': f\"{trans_r2:.4f}\" if not np.isnan(trans_r2) else \"N/A\",\n",
        "                    'R2_Diff': r2_diff_str,\n",
        "                    'Original_Social': f\"{orig_social:.4f}\" if not np.isnan(orig_social) else \"N/A\",\n",
        "                    'Trans_Social': f\"{trans_social:.4f}\" if not np.isnan(trans_social) else \"N/A\",\n",
        "                    'Original_N': f\"{orig_n}\" if not np.isnan(orig_n) else \"N/A\",\n",
        "                    'Trans_N': f\"{trans_n}\" if not np.isnan(trans_n) else \"N/A\"\n",
        "                })\n",
        "\n",
        "        # Create and display table\n",
        "        if table_data:\n",
        "            table_df = pd.DataFrame(table_data)\n",
        "\n",
        "            print(f\"\\n{'Model':<50} {'Original R²':<12} {'Trans R²':<12} {'ΔR²':<10} {'Orig Social':<12} {'Trans Social':<12} {'Orig N':<8} {'Trans N':<8}\")\n",
        "            print(\"-\"*120)\n",
        "\n",
        "            for _, row in table_df.iterrows():\n",
        "                print(f\"{row['Model']:<50} {row['Original_R2']:<12} {row['Trans_R2']:<12} {row['R2_Diff']:<10} \"\n",
        "                      f\"{row['Original_Social']:<12} {row['Trans_Social']:<12} {row['Original_N']:<8} {row['Trans_N']:<8}\")\n",
        "\n",
        "            return table_df\n",
        "        return None\n",
