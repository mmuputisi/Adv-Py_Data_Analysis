        "def test_fe_structure(df, y_var, x_vars, entity_var='Firm', time_var='Year'):\n",
        "    \"\"\"Test FE structure using Hausman and F-tests\"\"\"\n",
        "    print(f\"\\n{'='*80}\")\n",
        "    print(\"FIXED EFFECTS STRUCTURE TESTING\")\n",
        "    print(f\"{'='*80}\")\n",
        "\n",
        "    # Reset index for statsmodels\n",
        "    df_reset = df.reset_index()\n",
        "\n",
        "    # Prepare data\n",
        "    y = df_reset[y_var]\n",
        "    X = df_reset[x_vars]\n",
        "    X = sm.add_constant(X)\n",
        "\n",
        "    # Pooled OLS (no FE)\n",
        "    pooled = sm.OLS(y, X).fit(cov_type='HC1')\n",
        "\n",
        "    # Entity FE using statsmodels\n",
        "    entity_dummies = pd.get_dummies(df_reset[entity_var], prefix='firm', drop_first=True)\n",
        "    X_fe = pd.concat([X, entity_dummies], axis=1)\n",
        "    fe_entity = sm.OLS(y, X_fe).fit(cov_type='HC1')\n",
        "\n",
        "    # Time FE\n",
        "    time_dummies = pd.get_dummies(df_reset[time_var], prefix='year', drop_first=True)\n",
        "    X_timefe = pd.concat([X, time_dummies], axis=1)\n",
        "    fe_time = sm.OLS(y, X_timefe).fit(cov_type='HC1')\n",
        "\n",
        "    # Two-way FE\n",
        "    X_twoway = pd.concat([X, entity_dummies, time_dummies], axis=1)\n",
        "    fe_twoway = sm.OLS(y, X_twoway).fit(cov_type='HC1')\n",
        "\n",
        "    # F-tests for FE significance\n",
        "    print(\"\\nF-TESTS FOR FIXED EFFECTS:\")\n",
        "    print(\"-\" * 50)\n",
        "\n",
        "    # Test entity FE vs pooled\n",
        "    ssr_pooled = pooled.ssr\n",
        "    ssr_fe = fe_entity.ssr\n",
        "    n_entities = df_reset[entity_var].nunique() - 1\n",
        "    n_obs = len(y)\n",
        "    k = len(x_vars) + 1  # +1 for constant\n",
        "\n",
        "    f_stat_entity = ((ssr_pooled - ssr_fe) / n_entities) / (ssr_fe / (n_obs - k - n_entities))\n",
        "    p_val_entity = 1 - stats.f.cdf(f_stat_entity, n_entities, n_obs - k - n_entities)\n",
        "\n",
        "    print(f\"Entity FE vs Pooled:\")\n",
        "    print(f\"  F-statistic: {f_stat_entity:.4f}\")\n",
        "    print(f\"  p-value: {p_val_entity:.4f}\")\n",
        "    print(f\"  Conclusion: {'Entity FE preferred' if p_val_entity < 0.05 else 'Pooled OLS preferred'}\")\n",
        "\n",
        "    # Test time FE vs pooled\n",
        "    ssr_time = fe_time.ssr\n",
        "    n_time = df_reset[time_var].nunique() - 1\n",
        "    f_stat_time = ((ssr_pooled - ssr_time) / n_time) / (ssr_time / (n_obs - k - n_time))\n",
        "    p_val_time = 1 - stats.f.cdf(f_stat_time, n_time, n_obs - k - n_time)\n",
        "\n",
        "    print(f\"\\nTime FE vs Pooled:\")\n",
        "    print(f\"  F-statistic: {f_stat_time:.4f}\")\n",
        "    print(f\"  p-value: {p_val_time:.4f}\")\n",
        "    print(f\"  Conclusion: {'Time FE preferred' if p_val_time < 0.05 else 'Pooled OLS preferred'}\")\n",
        "\n",
        "    # Test two-way FE vs pooled\n",
        "    n_total_dummies = n_entities + n_time\n",
        "    ssr_twoway = fe_twoway.ssr\n",
        "    f_stat_twoway = ((ssr_pooled - ssr_twoway) / n_total_dummies) / (ssr_twoway / (n_obs - k - n_total_dummies))\n",
        "    p_val_twoway = 1 - stats.f.cdf(f_stat_twoway, n_total_dummies, n_obs - k - n_total_dummies)\n",
        "\n",
        "    print(f\"\\nTwo-way FE vs Pooled:\")\n",
        "    print(f\"  F-statistic: {f_stat_twoway:.4f}\")\n",
        "    print(f\"  p-value: {p_val_twoway:.4f}\")\n",
        "    print(f\"  Conclusion: {'Two-way FE preferred' if p_val_twoway < 0.05 else 'Pooled OLS preferred'}\")\n",
        "\n",
        "    # Simplified Hausman test (FE vs RE)\n",
        "    print(\"\\n\" + \"=\"*50)\n",
        "    print(\"HAUSMAN-TYPE TEST (FE vs RE GUIDANCE):\")\n",
        "    print(\"=\"*50)\n",
        "    print(\"Note: Formal Hausman test requires random effects model\")\n",
        "    print(\"\\nDecision Rules:\")\n",
        "    print(\"1. If entity F-test significant (p < 0.05): Use entity FE\")\n",
        "    print(\"2. If time F-test significant (p < 0.05): Use time FE\")\n",
        "    print(\"3. If both significant: Use two-way FE\")\n",
        "    print(\"4. If neither significant: Pooled OLS may be sufficient\")\n",
        "\n",
        "    # Recommendation\n",
        "    print(\"\\n\" + \"=\"*50)\n",
        "    print(\"RECOMMENDED SPECIFICATION:\")\n",
        "    print(\"=\"*50)\n",
        "\n",
        "    if p_val_entity < 0.05 and p_val_time < 0.05:\n",
        "        print(\"Two-way Fixed Effects (firm and year)\")\n",
        "        recommendation = 'two-way'\n",
        "    elif p_val_entity < 0.05:\n",
        "        print(\"Entity Fixed Effects\")\n",
        "        recommendation = 'entity'\n",
        "    elif p_val_time < 0.05:\n",
        "        print(\"Time Fixed Effects\")\n",
        "        recommendation = 'time'\n",
        "    else:\n",
        "        print(\"Pooled OLS (no fixed effects)\")\n",
        "        recommendation = 'pooled'\n",
        "\n",
        "    return recommendation\n",
