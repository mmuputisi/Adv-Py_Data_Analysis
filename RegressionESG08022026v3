        "    if len(residuals) > 2:\n",
        "        stats.probplot(residuals, dist=\"norm\", plot=ax3)\n",
        "    ax3.set_title('Q-Q Plot of Residuals')\n",
        "    ax3.grid(True, alpha=0.3)\n",
        "\n",
        "    # Plot 4: Histogram of residuals\n",
        "    ax4 = plt.subplot(2, 3, 4)\n",
