        "def enhanced_esg_analysis(df, consumer_staples=True):\n",
        "    \"\"\"Main function to run enhanced ESG analysis\"\"\"\n",
        "\n",
        "    # Select data\n",
        "    if consumer_staples:\n",
        "        analysis_df = df[df['ConsumerStaples'] == 1].copy()\n",
        "        sector_name = 'CS'\n",
