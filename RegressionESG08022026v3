        "def binned_scatterplot_fe(df, x_var, y_var, control_vars=None,\n",
        "                         entity_fe=True, time_fe=True, n_bins=20):\n",
        "    \"\"\"Create binned scatterplot with FE partialling out controls\"\"\"\n",
        "    print(f\"\\n{'='*80}\")\n",
        "    print(f\"BINNED SCATTERPLOT: {x_var} vs {y_var}\")\n",
        "    print(f\"Controls partialled out, FE-adjusted\")\n",
        "    print(f\"{'='*80}\")\n",
        "\n",
        "    # Prepare data\n",
        "    df_temp = df.reset_index()\n",
        "\n",
        "    # Create FE dummies if requested\n",
        "    fe_formula = \"\"\n",
        "    if entity_fe:\n",
        "        df_temp['entity_dummy'] = df_temp['Firm']\n",
        "        fe_formula += \" + C(entity_dummy)\"\n",
        "\n",
        "    if time_fe:\n",
        "        df_temp['time_dummy'] = df_temp['Year']\n",
        "        fe_formula += \" + C(time_dummy)\"\n",
        "\n",
        "    # Create formula\n",
        "    if control_vars:\n",
        "        controls_str = \" + \".join(control_vars)\n",
        "        formula = f\"{y_var} ~ {x_var} + {controls_str}{fe_formula}\"\n",
        "    else:\n",
        "        formula = f\"{y_var} ~ {x_var}{fe_formula}\"\n",
        "\n",
        "    # Run regression\n",
        "    model = ols(formula, data=df_temp.dropna(subset=[x_var, y_var] + (control_vars or []))).fit()\n",
        "\n",
        "    # Get residuals (y after partialling out controls and FE)\n",
        "    df_temp['y_resid'] = model.resid + model.params.get('Intercept', 0)\n",
        "\n",
        "    # Also get x residuals if controls are specified\n",
        "    if control_vars:\n",
        "        x_formula = f\"{x_var} ~ {controls_str}{fe_formula}\"\n",
        "        x_model = ols(x_formula, data=df_temp.dropna(subset=[x_var] + control_vars)).fit()\n",
        "        df_temp['x_resid'] = x_model.resid + x_model.params.get('Intercept', 0)\n",
        "    else:\n",
        "        df_temp['x_resid'] = df_temp[x_var]\n",
        "\n",
        "    # Bin the data\n",
        "    df_temp['x_bin'] = pd.qcut(df_temp['x_resid'], n_bins, duplicates='drop')\n",
        "    binned = df_temp.groupby('x_bin').agg({\n",
        "        'x_resid': 'mean',\n",
        "        'y_resid': ['mean', 'std', 'count']\n",
        "    }).round(4)\n",
        "\n",
        "    binned.columns = ['x_mean', 'y_mean', 'y_std', 'count']\n",
        "    binned = binned.reset_index()\n",
        "\n",
        "    # Create scatterplot\n",
        "    fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
        "\n",
        "    # Binned scatterplot\n",
        "    axes[0].errorbar(binned['x_mean'], binned['y_mean'],\n",
        "                    yerr=binned['y_std']/np.sqrt(binned['count']),\n",
        "                    fmt='o', capsize=5, alpha=0.7, color='steelblue')\n",
        "\n",
        "    # Add regression line\n",
        "    z = np.polyfit(binned['x_mean'], binned['y_mean'], 1)\n",
        "    p = np.poly1d(z)\n",
        "    x_range = np.linspace(binned['x_mean'].min(), binned['x_mean'].max(), 100)\n",
        "    axes[0].plot(x_range, p(x_range), \"r--\", alpha=0.8, linewidth=2)\n",
        "\n",
        "    axes[0].set_xlabel(f'{x_var} (residualized)')\n",
        "    axes[0].set_ylabel(f'{y_var} (residualized)')\n",
        "    axes[0].set_title(f'Binned Scatterplot: {x_var} vs {y_var}\\nFE and Controls Partialled Out')\n",
        "    axes[0].grid(True, alpha=0.3)\n",
        "\n",
        "    # Add statistics\n",
        "    slope = z[0]\n",
        "    intercept = z[1]\n",
        "    axes[0].text(0.05, 0.95, f'Slope: {slope:.4f}\\nIntercept: {intercept:.4f}',\n",
        "                transform=axes[0].transAxes, fontsize=10,\n",
        "                verticalalignment='top',\n",
        "                bbox=dict(boxstyle='round', facecolor='wheat', alpha=0.8))\n",
        "\n",
        "    # Residual plot\n",
        "    axes[1].scatter(binned['x_mean'], binned['y_mean'] - p(binned['x_mean']),\n",
        "                   alpha=0.7, color='steelblue')\n",
        "    axes[1].axhline(y=0, color='r', linestyle='--', alpha=0.5)\n",
        "    axes[1].set_xlabel(f'{x_var} (residualized)')\n",
        "    axes[1].set_ylabel('Residuals')\n",
        "    axes[1].set_title('Residuals from Binned Regression')\n",
        "    axes[1].grid(True, alpha=0.3)\n",
        "\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "\n",
        "    print(\"\\nBinned Statistics:\")\n",
        "    print(binned)\n",
        "\n",
        "    return binned\n",
        "\n",
        "def coefficient_plot_models(model_results_dict, target_vars=None):\n",
        "    \"\"\"Create coefficient plot comparing across model specifications\"\"\"\n",
        "    print(f\"\\n{'='*80}\")\n",
        "    print(\"COEFFICIENT COMPARISON ACROSS MODEL SPECIFICATIONS\")\n",
        "    print(f\"{'='*80}\")\n",
        "\n",
        "    # Prepare data for plotting\n",
        "    plot_data = []\n",
        "\n",
        "    for model_name, model_data in model_results_dict.items():\n",
        "        if isinstance(model_data, dict) and 'results' in model_data:\n",
        "            results = model_data['results']\n",
        "        elif hasattr(model_data, 'params'):\n",
        "            results = model_data\n",
        "        else:\n",
        "            continue\n",
        "\n",
        "        # Extract coefficients for target variables\n",
        "        for var in results.params.index:\n",
        "            if target_vars and var not in target_vars:\n",
        "                continue\n",
        "            if var == 'const':\n",
        "                continue\n",
        "\n",
        "            plot_data.append({\n",
        "                'Model': model_name,\n",
        "                'Variable': var,\n",
        "                'Coefficient': results.params[var],\n",
        "                'StdError': results.std_errors.get(var, np.nan) if hasattr(results, 'std_errors') else np.nan,\n",
        "                'PValue': results.pvalues.get(var, np.nan)\n",
        "            })\n",
        "\n",
        "    if not plot_data:\n",
        "        print(\"No model results found for plotting\")\n",
        "        return\n",
        "\n",
        "    plot_df = pd.DataFrame(plot_data)\n",
        "\n",
        "    # Filter to variables that appear in multiple models\n",
        "    var_counts = plot_df['Variable'].value_counts()\n",
        "    common_vars = var_counts[var_counts > 1].index.tolist()\n",
        "\n",
        "    if not common_vars:\n",
        "        print(\"No common variables across models\")\n",
        "        return\n",
        "\n",
        "    plot_df = plot_df[plot_df['Variable'].isin(common_vars)]\n",
        "\n",
        "    # Create coefficient plot\n",
        "    fig, ax = plt.subplots(figsize=(12, 8))\n",
        "\n",
        "    # Get unique models and variables\n",
        "    models = plot_df['Model'].unique()\n",
        "    variables = plot_df['Variable'].unique()\n",
        "\n",
        "    # Set positions\n",
        "    n_models = len(models)\n",
        "    n_vars = len(variables)\n",
        "\n",
        "    # Color map\n",
        "    colors = plt.cm.Set3(np.linspace(0, 1, n_models))\n",
        "\n",
        "    # Plot each model\n",
        "    for i, model in enumerate(models):\n",
        "        model_data = plot_df[plot_df['Model'] == model]\n",
        "\n",
        "        # Match variable order\n",
        "        coeffs = []\n",
        "        errors = []\n",
        "        for var in variables:\n",
        "            var_data = model_data[model_data['Variable'] == var]\n",
        "            if len(var_data) > 0:\n",
        "                coeffs.append(var_data['Coefficient'].values[0])\n",
        "                errors.append(var_data['StdError'].values[0])\n",
        "            else:\n",
        "                coeffs.append(np.nan)\n",
        "                errors.append(np.nan)\n",
        "\n",
        "        # Plot with error bars\n",
        "        x_pos = np.arange(n_vars) + i * 0.2\n",
        "        ax.errorbar(x_pos, coeffs, yerr=errors, fmt='o',\n",
        "                   color=colors[i], label=model, capsize=5,\n",
        "                   alpha=0.8, markersize=8)\n",
        "\n",
        "    ax.axhline(y=0, color='black', linestyle='-', alpha=0.3, linewidth=0.5)\n",
        "    ax.set_xlabel('Variables')\n",
        "    ax.set_ylabel('Coefficient Estimate')\n",
        "    ax.set_title('Coefficient Comparison Across Model Specifications')\n",
        "    ax.set_xticks(np.arange(n_vars) + 0.2 * (n_models - 1) / 2)\n",
        "    ax.set_xticklabels(variables, rotation=45, ha='right')\n",
        "    ax.legend(bbox_to_anchor=(1.05, 1), loc='upper left')\n",
        "    ax.grid(True, alpha=0.3, axis='y')\n",
        "\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "\n",
        "    # Print comparison table\n",
        "    print(\"\\nCoefficient Comparison Table:\")\n",
        "    print(\"-\" * 80)\n",
        "\n",
        "    # Create pivot table\n",
        "    pivot_coeff = plot_df.pivot(index='Variable', columns='Model', values='Coefficient')\n",
        "    pivot_pval = plot_df.pivot(index='Variable', columns='Model', values='PValue')\n",
        "\n",
        "    print(\"\\nCoefficients:\")\n",
        "    print(pivot_coeff.round(4))\n",
        "\n",
        "    print(\"\\nP-values:\")\n",
        "    print(pivot_pval.round(4))\n",
        "\n",
        "def run_robustness_specifications(df, y_var, x_vars, model_name):\n",
        "    \"\"\"Run high-impact robustness checks\"\"\"\n",
        "    print(f\"\\n{'='*80}\")\n",
        "    print(f\"ROBUSTNESS CHECKS: {model_name}\")\n",
        "    print(f\"{'='*80}\")\n",
        "\n",
        "    robustness_results = {}\n",
        "\n",
        "    # Specification 1: Two-way FE with firm-clustered SE\n",
        "    print(\"\\n1. TWO-WAY FIXED EFFECTS WITH FIRM-CLUSTERED SE\")\n",
        "    print(\"-\" * 50)\n",
        "\n",
        "    try:\n",
        "        df_clean = df.dropna(subset=[y_var] + x_vars)\n",
        "        y = df_clean[y_var]\n",
        "        X = df_clean[x_vars]\n",
        "        X = pd.concat([pd.Series(1, index=X.index, name='const'), X], axis=1)\n",
        "\n",
        "        model = PanelOLS(y, X, entity_effects=True, time_effects=True)\n",
        "        results = model.fit(cov_type='clustered', cluster_entity=True)\n",
        "\n",
        "        robustness_results['Two-way FE + Firm-clustered SE'] = results\n",
        "\n",
        "        print(f\"Observations: {results.nobs}\")\n",
        "        print(f\"Firms: {df_clean.index.get_level_values(0).nunique()}\")\n",
        "        print(f\"Years: {df_clean.index.get_level_values(1).nunique()}\")\n",
        "        print(f\"R-squared: {results.rsquared:.4f}\")\n",
        "        print(f\"R-squared (within): {results.rsquared_within:.4f}\")\n",
        "\n",
        "        # Print key coefficients\n",
        "        print(\"\\nKey coefficients:\")\n",
        "        for var in ['E_lag', 'S_lag', 'G_lag']:\n",
        "            if var in results.params:\n",
        "                coeff = results.params[var]\n",
        "                pval = results.pvalues.get(var, 1.0)\n",
        "                sig = \"***\" if pval < 0.01 else \"**\" if pval < 0.05 else \"*\" if pval < 0.10 else \"\"\n",
        "                print(f\"  {var}: {coeff:.4f}{sig} (p={pval:.4f})\")\n",
        "\n",
        "    except Exception as e:\n",
        "        print(f\"Failed: {str(e)}\")\n",
        "\n",
        "    # Specification 2: Winsorized variables\n",
