        "\n",
        "# Colab setup, Drive paths, imports\n",
        "from google.colab import drive\n",
        "drive.mount('/content/drive')\n",
        "!pip install -q linearmodels\n",
        "\n",
        "import os\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "from linearmodels.panel import PanelOLS, compare\n",
        "from statsmodels.stats.outliers_influence import variance_inflation_factor\n",
        "import re\n",
        "import warnings\n",
        "warnings.filterwarnings('ignore')\n",
        "import statsmodels.api as sm\n",
        "from scipy import stats\n",
        "from scipy.stats import shapiro, skew, kurtosis\n",
        "from statsmodels.stats.diagnostic import het_breuschpagan\n",
        "from statsmodels.stats.stattools import durbin_watson\n",
        "from sklearn.preprocessing import PowerTransformer\n",
        "from statsmodels.formula.api import ols\n",
        "\n",
        "# ============================================================================\n",
        "# DATA LOADING AND PREPARATION (MUST COME FIRST)\n",
        "# ============================================================================\n",
        "print(\"=\"*70)\n",
        "print(\"ULTIMATE ESG IMPACT ANALYSIS WITH LAGGED SPECIFICATION\")\n",
        "print(\"=\"*70)\n",
        "\n",
        "PROJECT_DIR = '/content/drive/MyDrive/Colab Notebooks/FTSE Data'\n",
        "DATA_PATH = os.path.join(PROJECT_DIR, 'FTSE data.xlsx')\n",
        "OUT_DIR = os.path.join(PROJECT_DIR, 'outputs_esg_tobinq')\n",
        "os.makedirs(OUT_DIR, exist_ok=True)\n",
        "\n",
        "print(f\"Data path: {DATA_PATH}\")\n",
        "print(f\"Output directory: {OUT_DIR}\")\n",
        "\n",
        "# Load the Excel file from Drive\n",
        "df = pd.read_excel(DATA_PATH)\n",
        "df = df.set_index(['Firm', 'Year']).sort_index()\n",
        "df = df.rename(columns={\"Tobin's Q\": \"Tobin_Q\"})\n",
        "df['Size'] = np.log(df['Total Assets'])\n",
        "df['Leverage'] = df['Total Liabilities'] / df['Total Assets']\n",
        "df['Tobin_Q_log'] = np.log(df['Tobin_Q'] + 0.001)\n",
        "\n",
        "print(f\"\\nLoaded {len(df)} observations, {df.index.get_level_values(0).nunique()} firms\")\n",
        "\n",
        "# ============================================================================\n",
        "# CRITICAL: CREATE LAGGED VARIABLES FOR CORRECT TIMING\n",
        "# ============================================================================\n",
        "print(\"\\n\" + \"=\"*70)\n",
        "print(\"CREATING LAGGED VARIABLES FOR CORRECT TIMING\")\n",
        "print(\"=\"*70)\n",
        "\n",
        "# Create lagged ESG variables (t-1) - MUST BE DONE BEFORE ANY ANALYSIS\n",
        "df['E_lag'] = df.groupby(level=0)['E'].shift(1)\n",
        "df['S_lag'] = df.groupby(level=0)['S'].shift(1)\n",
        "df['G_lag'] = df.groupby(level=0)['G'].shift(1)\n",
        "\n",
        "# Create lagged control variables for consistency\n",
        "df['ROA_lag'] = df.groupby(level=0)['ROA'].shift(1)\n",
        "df['Size_lag'] = df.groupby(level=0)['Size'].shift(1)\n",
        "df['Leverage_lag'] = df.groupby(level=0)['Leverage'].shift(1)\n",
        "\n",
        "print(f\"Created lagged variables for ESG and controls\")\n",
        "print(f\"Missing observations due to lagging: {df[['E_lag', 'S_lag', 'G_lag']].isnull().sum().sum()}\")\n",
        "\n",
        "# ============================================================================\n",
        "# CREATE TRANSFORMED TOBIN'S Q VARIABLES\n",
        "# ============================================================================\n",
        "print(\"\\n\" + \"-\"*70)\n",
        "print(\"CREATING TRANSFORMED TOBIN'S Q VARIABLES\")\n",
        "print(\"-\"*70)\n",
        "\n",
        "# Create log transformation (Box-Cox λ ≈ 0)\n",
        "df['Tobin_Q_log'] = np.log(df['Tobin_Q'] + 0.001)\n",
        "\n",
        "# Create inverse transformation (for robustness check)\n",
        "df['Tobin_Q_inv'] = 1 / (df['Tobin_Q'] + 0.001)\n",
        "\n",
        "print(\"✓ Created log and inverse transformations of Tobin's Q\")\n",
        "print(f\"  • Tobin_Q_log: log(Tobin's Q + 0.001)\")\n",
        "print(f\"  • Tobin_Q_inv: 1/(Tobin's Q + 0.001)\")\n",
        "\n",
        "# ============================================================================\n",
        "# SECTOR SETUP\n",
        "# ============================================================================\n",
        "# Define Consumer Staples firms\n",
        "consumer_staples_firms = [\n",
        "    'Associated British Foods', 'British American Tobacco', 'Coca Cola HBC AG',\n",
        "    'Diageo', 'J. Sainsbury', 'Reckitt Benckiser', 'Tesco', 'Unilever', 'Haleon Plc'\n",
        "]\n",
        "\n",
        "# Create sector variable\n",
        "firm_names = df.index.get_level_values(0)\n",
        "sectors = []\n",
        "for firm in firm_names:\n",
        "    if firm in consumer_staples_firms:\n",
        "        sectors.append('Consumer Staples')\n",
        "    else:\n",
        "        sectors.append('Other')\n",
        "df['Sector'] = sectors\n",
        "df['ConsumerStaples'] = (df['Sector'] == 'Consumer Staples').astype(int)\n",
        "\n",
        "print(\"\\n\" + \"=\"*70)\n",
        "print(\"DATA SUMMARY WITH LAGGED VARIABLES\")\n",
        "print(\"=\"*70)\n",
        "print(f\"Total observations: {len(df)}\")\n",
        "print(f\"Number of firms: {df.index.get_level_values(0).nunique()}\")\n",
        "print(f\"Years: {sorted(df.index.get_level_values(1).unique())}\")\n",
        "print(f\"\\nSector Distribution:\")\n",
        "print(f\"Consumer Staples firms: {df[df['ConsumerStaples']==1].index.get_level_values(0).nunique()}\")\n",
        "print(f\"Other sectors firms: {df[df['ConsumerStaples']==0].index.get_level_values(0).nunique()}\")\n",
        "print(f\"\\nTiming Specification: ESG(t-1) → Tobin's Q(t)\")\n",
        "\n",
        "# ============================================================================\n",
        "# CREATE ADDITIONAL TRANSFORMATIONS FOR ENHANCED ANALYSIS\n",
        "# ============================================================================\n",
        "print(\"\\n\" + \"=\"*70)\n",
        "print(\"CREATING ADDITIONAL TRANSFORMATIONS FOR ENHANCED ANALYSIS\")\n",
        "print(\"=\"*70)\n",
        "\n",
        "# Create moving averages for enhanced analysis\n",
        "for component in ['E_lag', 'S_lag', 'G_lag']:\n",
        "    # 2-year moving averages\n",
        "    df[f'{component}_ma2'] = df.groupby(level=0)[component].rolling(window=2, min_periods=2).mean().reset_index(level=0, drop=True)\n",
        "    # 3-year moving averages\n",
        "    df[f'{component}_ma3'] = df.groupby(level=0)[component].rolling(window=3, min_periods=3).mean().reset_index(level=0, drop=True)\n",
        "\n",
        "print(\"✓ Created 2-year and 3-year moving averages of lagged ESG\")\n",
        "\n",
        "# ============================================================================\n",
        "# HELPER FUNCTIONS\n",
        "# ============================================================================\n",
        "def create_decaying_avg(series, decay_rate, max_lag=3):\n",
        "    \"\"\"Create exponentially decaying weighted average\"\"\"\n",
        "    n = len(series)\n",
        "    decaying_avg = np.zeros(n)\n",
        "\n",
        "    for i in range(n):\n",
        "        total_weight = 0\n",
        "        weighted_sum = 0\n",
        "\n",
        "        for lag in range(max_lag + 1):\n",
        "            if i - lag >= 0:\n",
        "                weight = decay_rate ** lag\n",
        "                weighted_sum += weight * series.iloc[i - lag]\n",
        "                total_weight += weight\n",
        "\n",
        "        if total_weight > 0:\n",
        "            decaying_avg[i] = weighted_sum / total_weight\n",
        "\n",
        "    return decaying_avg\n",
        "\n",
        "def create_cumulative(series, depreciation=0):\n",
        "    \"\"\"Create cumulative sum with optional depreciation\"\"\"\n",
        "    cumulative = []\n",
        "    current = 0\n",
        "\n",
        "    for value in series:\n",
        "        if pd.isna(value):\n",
        "            cumulative.append(np.nan)\n",
        "        else:\n",
        "            current = (1 - depreciation) * current + value\n",
        "            cumulative.append(current)\n",
        "\n",
        "    return cumulative\n",
        "\n",
        "def safe_assign(df, column_name, values):\n",
        "    \"\"\"Safely assign values to a dataframe column without warnings\"\"\"\n",
        "    df = df.copy()\n",
        "    df.loc[:, column_name] = values\n",
        "    return df\n",
        "\n",
