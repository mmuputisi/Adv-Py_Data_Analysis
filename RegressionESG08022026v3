        "def analyze_tobinq_distribution(df, tobinq_var='Tobin_Q'):\n",
        "    \"\"\"Analyze and transform Tobin's Q for potential right skewness\"\"\"\n",
        "    print(f\"\\n{'='*80}\")\n",
        "    print(\"TOBIN'S Q DISTRIBUTION ANALYSIS\")\n",
        "    print(f\"{'='*80}\")\n",
        "\n",
        "    tobinq_data = df[tobinq_var].dropna()\n",
        "\n",
        "    # Original distribution\n",
        "    print(\"\\nORIGINAL DISTRIBUTION:\")\n",
        "    print(f\"Mean: {tobinq_data.mean():.4f}\")\n",
        "    print(f\"Median: {tobinq_data.median():.4f}\")\n",
        "    print(f\"Std Dev: {tobinq_data.std():.4f}\")\n",
        "    print(f\"Skewness: {stats.skew(tobinq_data):.4f}\")\n",
        "    print(f\"Kurtosis: {stats.kurtosis(tobinq_data):.4f}\")\n",
        "\n",
        "    # Shapiro-Wilk test for normality\n",
        "    shapiro_stat, shapiro_p = shapiro(tobinq_data)\n",
        "    print(f\"Shapiro-Wilk test p-value: {shapiro_p:.6f}\")\n",
        "    print(f\"Normality: {'Rejected' if shapiro_p < 0.05 else 'Not rejected'}\")\n",
        "\n",
        "    # Plot original distribution\n",
        "    fig, axes = plt.subplots(1, 2, figsize=(12, 4))\n",
        "\n",
        "    # Histogram\n",
        "    axes[0].hist(tobinq_data, bins=30, edgecolor='black', alpha=0.7)\n",
        "    axes[0].axvline(tobinq_data.mean(), color='red', linestyle='--', label=f'Mean: {tobinq_data.mean():.2f}')\n",
        "    axes[0].axvline(tobinq_data.median(), color='green', linestyle='--', label=f'Median: {tobinq_data.median():.2f}')\n",
        "    axes[0].set_xlabel('Tobin\\'s Q')\n",
        "    axes[0].set_ylabel('Frequency')\n",
        "    axes[0].set_title('Original Tobin\\'s Q Distribution')\n",
        "    axes[0].legend()\n",
        "    axes[0].grid(True, alpha=0.3)\n",
        "\n",
        "    # Q-Q plot\n",
        "    stats.probplot(tobinq_data, dist=\"norm\", plot=axes[1])\n",
        "    axes[1].set_title('Q-Q Plot (Original)')\n",
        "    axes[1].grid(True, alpha=0.3)\n",
        "\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "\n",
        "    # Test transformations\n",
        "    transformations = {\n",
        "        'log': np.log(tobinq_data + 1 - tobinq_data.min()),  # Log transformation\n",
        "        'sqrt': np.sqrt(tobinq_data),  # Square root\n",
        "        'inverse': 1 / (tobinq_data + 1),  # Inverse\n",
        "        'boxcox': None  # Will calculate below\n",
        "    }\n",
        "\n",
        "    # Box-Cox transformation (requires positive values)\n",
        "    if (tobinq_data > 0).all():\n",
        "        try:\n",
        "            transformed_data, lambda_val = stats.boxcox(tobinq_data)\n",
        "            transformations['boxcox'] = transformed_data\n",
        "            print(f\"\\nBox-Cox lambda: {lambda_val:.4f}\")\n",
        "        except:\n",
        "            pass\n",
        "\n",
        "    print(f\"\\n{'='*50}\")\n",
        "    print(\"TRANSFORMATION COMPARISON:\")\n",
        "    print(f\"{'='*50}\")\n",
        "    print(f\"{'Transformation':<15} {'Skewness':<15} {'K-S Normality p-value':<20}\")\n",
        "    print(\"-\" * 50)\n",
        "\n",
        "    best_transform = None\n",
        "    best_skewness = float('inf')\n",
        "\n",
        "    for name, data in transformations.items():\n",
        "        if data is not None:\n",
        "            # Calculate skewness\n",
        "            current_skewness = abs(stats.skew(data))\n",
        "\n",
        "            # Kolmogorov-Smirnov test for normality\n",
        "            ks_stat, ks_p = stats.kstest(data, 'norm',\n",
        "                                        args=(data.mean(), data.std()))\n",
        "\n",
        "            print(f\"{name:<15} {current_skewness:<15.4f} {ks_p:<20.6f}\")\n",
        "\n",
        "            if current_skewness < best_skewness:\n",
        "                best_skewness = current_skewness\n",
        "                best_transform = name\n",
        "\n",
        "    print(f\"\\nRecommended transformation: {best_transform}\")\n",
        "\n",
        "    # Apply best transformation\n",
        "    if best_transform == 'log':\n",
        "        df[f'{tobinq_var}_transformed'] = np.log(df[tobinq_var] + 1 - df[tobinq_var].min())\n",
        "    elif best_transform == 'sqrt':\n",
        "        df[f'{tobinq_var}_transformed'] = np.sqrt(df[tobinq_var])\n",
        "    elif best_transform == 'inverse':\n",
        "        df[f'{tobinq_var}_transformed'] = 1 / (df[tobinq_var] + 1)\n",
        "    elif best_transform == 'boxcox' and (df[tobinq_var] > 0).all():\n",
        "        transformed, _ = stats.boxcox(df[tobinq_var])\n",
        "        df[f'{tobinq_var}_transformed'] = transformed\n",
        "\n",
        "    return df, best_transform\n",
        "\n",
