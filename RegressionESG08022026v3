        "    # Create decaying average for each firm\n",
        "    decaying_avgs = []\n",
        "    for firm in df_test.index.get_level_values(0).unique():\n",
        "        firm_data = df_test.xs(firm, level=0)\n",
        "        if len(firm_data) > 0:\n",
        "            decaying_avg = create_decaying_avg(firm_data[component], decay_rate, max_lag=3)\n",
