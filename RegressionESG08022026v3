        "            print(f\"  → Optimal: {optimal_decay:.3f}\")\n",
        "        else:\n",
        "            optimal_decays_lagged[component] = 0.5\n",
        "            print(f\"\\n{component}: Using default decay rate 0.5 (insufficient data for optimization)\")\n",
        "else:\n",
        "    print(\"Using default decay rates (insufficient data for optimization)\")\n",
        "    optimal_decays_lagged = {'E_lag': 0.5, 'S_lag': 0.5, 'G_lag': 0.5}\n",
        "\n",
        "# Apply optimal decay rates to LAGGED ESG\n",
        "df_optimal = df_lags_clean.copy() if 'df_lags_clean' in locals() else df_cs.copy()\n",
        "for component, decay_rate in optimal_decays_lagged.items():\n",
        "    decaying_avgs = []\n",
        "    for firm in df_optimal.index.get_level_values(0).unique():\n",
        "        firm_data = df_optimal.xs(firm, level=0)\n",
        "        if len(firm_data) > 0:\n",
        "            decaying_avg = create_decaying_avg(firm_data[component], decay_rate, max_lag=3)\n",
        "            decaying_avgs.extend(decaying_avg)\n",
        "        else:\n",
        "            decaying_avgs.extend([np.nan] * len(firm_data))\n",
        "\n",
        "    df_optimal[f'{component}_optdecay'] = decaying_avgs\n",
