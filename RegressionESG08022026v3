        "    def determine_best_transformation(self):\n",
        "        \"\"\"Determine best Tobin's Q transformation based on analysis\"\"\"\n",
        "        print(\"\\n\" + \"=\"*80)\n",
        "        print(\"DETERMINING BEST TOBIN'S Q TRANSFORMATION\")\n",
        "        print(\"=\"*80)\n",
        "\n",
        "        # Run your existing transformation analysis\n",
        "        df_transformed, best_transform = analyze_tobinq_distribution(self.df, 'Tobin_Q')\n",
        "        self.df = df_transformed\n",
        "\n",
        "        print(f\"\\n✓ Recommended transformation: {best_transform}\")\n",
        "\n",
        "        # Map transformation names to column names\n",
        "        transformation_map = {\n",
        "            'log': 'Tobin_Q_log',\n",
        "            'sqrt': 'Tobin_Q_sqrt',\n",
        "            'inverse': 'Tobin_Q_inv',\n",
        "            'boxcox': 'Tobin_Q_transformed'\n",
        "        }\n",
        "\n",
        "        # Check which transformed column exists\n",
        "        if best_transform in transformation_map:\n",
        "            trans_col = transformation_map[best_transform]\n",
        "            if trans_col in self.df.columns:\n",
        "                self.best_transformation = trans_col\n",
        "                print(f\"✓ Using column: {trans_col}\")\n",
        "            else:\n",
        "                # Fall back to log if recommended doesn't exist\n",
        "                self.best_transformation = 'Tobin_Q_log'\n",
        "                print(f\"⚠ {trans_col} not found, using Tobin_Q_log instead\")\n",
        "        else:\n",
        "            self.best_transformation = 'Tobin_Q_log'\n",
        "            print(f\"⚠ Unknown transformation {best_transform}, using Tobin_Q_log\")\n",
        "\n",
        "        return self.best_transformation\n",
        "\n",
        "    def create_all_transformations(self):\n",
        "        \"\"\"Create all ESG transformations\"\"\"\n",
        "        print(\"\\n\" + \"-\"*80)\n",
        "        print(\"CREATING ALL ESG TRANSFORMATIONS\")\n",
        "        print(\"-\"*80)\n",
        "\n",
        "        # 1. Simple 1-year lag\n",
        "        print(\"✓ 1. Simple 1-year lag\")\n",
        "\n",
        "        # 2. 2-year MA\n",
        "        for component in ['E_lag', 'S_lag', 'G_lag']:\n",
        "            if f'{component}_ma2' not in self.df.columns:\n",
        "                self.df[f'{component}_ma2'] = self.df.groupby(level=0)[component].rolling(\n",
        "                    window=2, min_periods=2).mean().reset_index(level=0, drop=True)\n",
        "        print(\"✓ 2. 2-year moving average\")\n",
        "\n",
        "        # 3. 3-year MA\n",
        "        for component in ['E_lag', 'S_lag', 'G_lag']:\n",
        "            if f'{component}_ma3' not in self.df.columns:\n",
        "                self.df[f'{component}_ma3'] = self.df.groupby(level=0)[component].rolling(\n",
        "                    window=3, min_periods=3).mean().reset_index(level=0, drop=True)\n",
        "        print(\"✓ 3. 3-year moving average\")\n",
        "\n",
        "        # 4. Distributed lags - INDIVIDUAL LAGS (for high R² model)\n",
        "        print(\"\\nCreating distributed lags...\")\n",
        "        for component in ['E', 'S', 'G']:\n",
        "            for lag in range(1, 6):\n",
        "                self.df[f'{component}_lag{lag}'] = self.df.groupby(level=0)[component].shift(lag)\n",
        "\n",
        "        # Also create summed versions\n",
        "        for component in ['E', 'S', 'G']:\n",
        "            lag1 = self.df.groupby(level=0)[component].shift(1)\n",
        "            lag2 = self.df.groupby(level=0)[component].shift(2)\n",
        "            lag3 = self.df.groupby(level=0)[component].shift(3)\n",
        "            lag4 = self.df.groupby(level=0)[component].shift(4)\n",
        "            lag5 = self.df.groupby(level=0)[component].shift(5)\n",
        "\n",
        "            self.df[f'{component}_lag12'] = lag1 + lag2\n",
        "            self.df[f'{component}_lag13'] = lag1 + lag2 + lag3\n",
        "            self.df[f'{component}_lag14'] = lag1 + lag2 + lag3 + lag4\n",
        "            self.df[f'{component}_lag15'] = lag1 + lag2 + lag3 + lag4 + lag5\n",
        "        print(\"✓ 4. Distributed lags (individual and summed)\")\n",
        "\n",
        "        # 5. Non-linear transformations\n",
        "        for component in ['E_lag', 'S_lag', 'G_lag']:\n",
        "            self.df[f'{component}_sq'] = self.df[component] ** 2\n",
        "        print(\"✓ 5. Quadratic terms\")\n",
        "\n",
        "        # 6. Optimal decay\n",
        "        for component in ['E_lag', 'S_lag', 'G_lag']:\n",
        "            decaying_avgs = []\n",
        "            for firm in self.df.index.get_level_values(0).unique():\n",
        "                firm_data = self.df.xs(firm, level=0)\n",
        "                if len(firm_data) > 0:\n",
        "                    series_data = firm_data[component].fillna(0)\n",
        "                    decaying_avg = create_decaying_avg(series_data, decay_rate=0.9, max_lag=3)\n",
        "                    decaying_avgs.extend(decaying_avg)\n",
        "                else:\n",
        "                    decaying_avgs.extend([np.nan] * len(firm_data))\n",
        "            self.df[f'{component}_decay'] = decaying_avgs\n",
        "        print(\"✓ 6. Optimal decay rates\")\n",
        "\n",
        "        # 7. ESG capital stock\n",
        "        for component in ['E_lag', 'S_lag', 'G_lag']:\n",
        "            capital_series = []\n",
        "            for firm in self.df.index.get_level_values(0).unique():\n",
        "                firm_data = self.df.xs(firm, level=0)\n",
        "                series_data = firm_data[component].fillna(0)\n",
        "                capital = create_cumulative(series_data, depreciation=0.3)\n",
        "                capital_series.extend(capital)\n",
        "            self.df[f'{component}_capital'] = capital_series\n",
        "        print(\"✓ 7. ESG capital stock\")\n",
        "\n",
        "        # 8. Change in lagged ESG\n",
        "        for component in ['E_lag', 'S_lag', 'G_lag']:\n",
        "            self.df[f'{component}_chg'] = self.df.groupby(level=0)[component].diff(1)\n",
        "        print(\"✓ 8. Change variables\")\n",
        "\n",
        "        # Clean data\n",
        "        self.df = self.df.replace([np.inf, -np.inf], np.nan)\n",
        "\n",
        "        print(\"\\n\" + \"-\"*80)\n",
        "        print(\"ALL TRANSFORMATIONS CREATED\")\n",
        "        print(\"-\"*80)\n",
        "\n",
        "        return self.df\n",
        "\n",
