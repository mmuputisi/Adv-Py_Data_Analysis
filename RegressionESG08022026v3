        "                    decaying_avgs.extend(decaying_avg)\n",
        "                else:\n",
        "                    decaying_avgs.extend([np.nan] * len(firm_data))\n",
        "            self.df[f'{component}_decay'] = decaying_avgs\n",
        "        print(\"✓ 6. Optimal decay rates\")\n",
        "\n",
        "        # 7. ESG capital stock\n",
        "        for component in ['E_lag', 'S_lag', 'G_lag']:\n",
