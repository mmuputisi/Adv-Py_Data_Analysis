        "print(\"COEFFICIENT AND P-VALUE SUMMARY FOR ALL MODELS - ALL SECTORS\")\n",
        "print(\"=\"*80)\n",
        "\n",
        "def extract_coefficients_pvalues(results_obj, model_name, sector='All'):\n",
