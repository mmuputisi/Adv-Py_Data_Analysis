        "        q_high = df_winsor[y_var].quantile(0.99)\n",
        "        df_winsor[y_var] = df_winsor[y_var].clip(lower=q_low, upper=q_high)\n",
        "\n",
        "        # Winsorize control variables\n",
        "        for var in ['ROA', 'Size', 'Leverage']:\n",
        "            if var in df_winsor.columns:\n",
        "                q_low_var = df_winsor[var].quantile(0.01)\n",
