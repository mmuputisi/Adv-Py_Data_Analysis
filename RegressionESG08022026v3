        "    else:\n",
        "        y_var = 'Tobin_Q'\n",
        "        print(\"\\nUsing original Tobin's Q\")\n",
        "\n",
        "    # 2. Test FE structure\n",
        "    print(\"\\n\" + \"=\"*80)\n",
        "    print(\"STEP 2: FIXED EFFECTS STRUCTURE TESTING\")\n",
        "    print(\"=\"*80)\n",
        "\n",
        "    # Define variables\n",
        "    esg_vars = ['E_lag', 'S_lag', 'G_lag']\n",
        "    control_vars = ['ROA', 'Size', 'Leverage']\n",
        "\n",
        "    fe_recommendation = test_fe_structure(analysis_df, y_var, esg_vars + control_vars)\n",
        "\n",
        "    # 3. Run main regression with multiple SE choices\n",
        "    print(\"\\n\" + \"=\"*80)\n",
        "    print(\"STEP 3: MAIN REGRESSION WITH MULTIPLE STANDARD ERRORS\")\n",
        "    print(\"=\"*80)\n",
        "\n",
