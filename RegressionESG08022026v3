        "\n",
        "        # 1. Simple 1-year lag\n",
        "        print(\"✓ 1. Simple 1-year lag\")\n",
        "\n",
        "        # 2. 2-year MA\n",
        "        for component in ['E_lag', 'S_lag', 'G_lag']:\n",
        "            if f'{component}_ma2' not in self.df.columns:\n",
        "                self.df[f'{component}_ma2'] = self.df.groupby(level=0)[component].rolling(\n",
        "                    window=2, min_periods=2).mean().reset_index(level=0, drop=True)\n",
        "        print(\"✓ 2. 2-year moving average\")\n",
        "\n",
        "        # 3. 3-year MA\n",
        "        for component in ['E_lag', 'S_lag', 'G_lag']:\n",
        "            if f'{component}_ma3' not in self.df.columns:\n",
        "                self.df[f'{component}_ma3'] = self.df.groupby(level=0)[component].rolling(\n",
        "                    window=3, min_periods=3).mean().reset_index(level=0, drop=True)\n",
        "        print(\"✓ 3. 3-year moving average\")\n",
        "\n",
        "        # 4. Distributed lags - INDIVIDUAL LAGS (for high R² model)\n",
        "        print(\"\\nCreating distributed lags...\")\n",
        "        for component in ['E', 'S', 'G']:\n",
        "            for lag in range(1, 6):\n",
        "                self.df[f'{component}_lag{lag}'] = self.df.groupby(level=0)[component].shift(lag)\n",
        "\n",
        "        # Also create summed versions\n",
        "        for component in ['E', 'S', 'G']:\n",
        "            lag1 = self.df.groupby(level=0)[component].shift(1)\n",
        "            lag2 = self.df.groupby(level=0)[component].shift(2)\n",
        "            lag3 = self.df.groupby(level=0)[component].shift(3)\n",
        "            lag4 = self.df.groupby(level=0)[component].shift(4)\n",
        "            lag5 = self.df.groupby(level=0)[component].shift(5)\n",
        "\n",
        "            self.df[f'{component}_lag12'] = lag1 + lag2\n",
