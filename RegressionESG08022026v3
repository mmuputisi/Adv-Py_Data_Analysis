        "        else:\n",
        "            decaying_avgs.extend([np.nan] * len(firm_data))\n",
        "\n",
        "    df_test[f'{component}_decay'] = decaying_avgs\n",
        "\n",
        "    # Drop NA\n",
        "    temp = df_test.dropna(subset=[f'{component}_decay', 'Tobin_Q', 'ROA', 'Size', 'Leverage'])\n",
        "\n",
        "    if len(temp) < 5:\n",
        "        return 1e10  # Return large value if insufficient data\n",
        "\n",
        "    # Run regression\n",
        "    y_temp = temp['Tobin_Q']\n",
        "    X_temp = temp[[f'{component}_decay', 'ROA', 'Size', 'Leverage']]\n",
        "    X_temp = pd.concat([pd.Series(1, index=X_temp.index, name='const'), X_temp], axis=1)\n",
        "\n",
        "    model_temp = PanelOLS(y_temp, X_temp, entity_effects=False, time_effects=False)\n",
        "    results_temp = model_temp.fit(cov_type='robust')\n",
        "\n",
        "    # Return negative R-squared (we want to maximize R²)\n",
        "    return -results_temp.rsquared\n",
        "\n",
        "# Find optimal decay rate for each LAGGED component using available data\n",
        "optimal_decays_lagged = {}\n",
        "if 'df_lags_clean' in locals() and len(df_lags_clean) > 0:\n",
        "    for component in ['E_lag', 'S_lag', 'G_lag']:\n",
        "        # Grid search from 0.1 to 0.9\n",
        "        decay_grid = np.linspace(0.1, 0.9, 9)\n",
        "        r2_values = []\n",
        "\n",
        "        for decay in decay_grid:\n",
        "            r2 = -objective_function_lagged(decay, component, df_lags_clean)\n",
        "            r2_values.append(r2)\n",
        "\n",
        "        # Find valid R² values\n",
        "        valid_r2 = [r for r in r2_values if r != -1e10]\n",
        "        if valid_r2:\n",
        "            optimal_decay = decay_grid[np.argmax(valid_r2)]\n",
        "            optimal_decays_lagged[component] = optimal_decay\n",
        "\n",
        "            print(f\"\\n{component} - Optimal decay rate search (CS Only):\")\n",
        "            for decay, r2 in zip(decay_grid, r2_values):\n",
        "                if r2 != -1e10:\n",
        "                    print(f\"  Decay {decay:.1f}: R² = {r2:.4f}\")\n",
        "            print(f\"  → Optimal: {optimal_decay:.3f}\")\n",
        "        else:\n",
