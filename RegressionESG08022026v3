        "    ax1.plot([min_val, max_val], [min_val, max_val], 'r--', alpha=0.5, label='Perfect fit')\n",
        "\n",
        "    # Calculate and plot regression line\n",
        "    if len(y_actual) > 1:\n",
        "        m, b = np.polyfit(y_actual, y_predicted, 1)\n",
        "        ax1.plot(y_actual, m*y_actual + b, 'g-', alpha=0.7, label=f'Fit: y={m:.3f}x+{b:.3f}')\n",
        "\n",
        "    ax1.set_xlabel('Observed Tobin\\'s Q')\n",
        "    ax1.set_ylabel('Expected Tobin\\'s Q')\n",
        "    ax1.set_title('Expected vs Observed Values')\n",
        "    ax1.legend()\n",
        "    ax1.grid(True, alpha=0.3)\n",
        "\n",
        "    # Calculate R²\n",
        "    ss_res = np.sum((y_actual - y_predicted) ** 2)\n",
        "    ss_tot = np.sum((y_actual - np.mean(y_actual)) ** 2)\n",
        "    r2 = 1 - (ss_res / ss_tot) if ss_tot != 0 else 0\n",
        "    ax1.text(0.05, 0.95, f'R² = {r2:.4f}', transform=ax1.transAxes,\n",
        "             fontsize=12, verticalalignment='top',\n",
        "             bbox=dict(boxstyle='round', facecolor='wheat', alpha=0.8))\n",
        "\n",
        "    # Plot 2: Residuals vs Fitted\n",
        "    ax2 = plt.subplot(2, 3, 2)\n",
        "    ax2.scatter(y_predicted, residuals, alpha=0.7, s=80, edgecolor='black', linewidth=0.5)\n",
