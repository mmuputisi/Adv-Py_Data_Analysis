        "                pval = results_obj.pvalues.get(var, 1.0)\n",
        "                coeff_data.append({\n",
        "                    'Model': model_name,\n",
        "                    'Sector': sector,\n",
        "                    'Variable': var,\n",
        "                    'Coefficient': coeff,\n",
        "                    'P-Value': pval,\n",
        "                    'Significant': pval < 0.10,\n",
        "                    'Obs': results_obj.nobs,\n",
        "                    'R2': results_obj.rsquared,\n",
        "                    'R2_within': getattr(results_obj, 'rsquared_within', None),\n",
        "                    'R2_between': getattr(results_obj, 'rsquared_between', None),\n",
        "                    'R2_overall': getattr(results_obj, 'rsquared_overall', None)\n",
        "                })\n",
        "\n",
        "    # Case 2: Dictionary containing results\n",
        "    elif isinstance(results_obj, dict):\n",
        "        # Check if it has 'results' key\n",
        "        if 'results' in results_obj:\n",
        "            return extract_coefficients_pvalues(results_obj['results'], model_name, sector)\n",
        "\n",
        "        # Check if it's a dictionary of results by SE type\n",
        "        for key, value in results_obj.items():\n",
        "            if hasattr(value, 'params'):\n",
        "                coeff_data.extend(\n",
        "                    extract_coefficients_pvalues(value, f\"{model_name} ({key})\", sector)\n",
        "                )\n",
        "\n",
        "    return coeff_data\n",
        "\n",
        "# Collect all coefficients from All Sectors models\n",
        "all_coeff_data = []\n",
        "\n",
        "# ============================================================================\n",
        "# 1. Extract from Enhanced Analysis (All Sectors)\n",
