        "def generate_regression_equation(model_name, results, variables, special_notes=None):\n",
        "    \"\"\"Generate a dynamic regression equation from model results\"\"\"\n",
        "\n",
        "    print(\"\\n\" + \"-\"*70)\n",
        "    print(f\"REGRESSION EQUATION - {model_name}:\")\n",
        "    print(\"-\"*70)\n",
        "\n",
        "    # Start with constant\n",
        "    eq_parts = []\n",
        "    if 'const' in results.params:\n",
        "        const = results.params['const']\n",
        "        # Format with proper sign\n",
        "        if const >= 0:\n",
        "            eq_parts.append(f\"{const:.4f}\")\n",
        "        else:\n",
        "            eq_parts.append(f\"- {abs(const):.4f}\")\n",
        "\n",
        "    # Add variables\n",
        "    for var in variables:\n",
        "        if var in results.params and var != 'const':\n",
        "            coef = results.params[var]\n",
        "            pval = results.pvalues[var] if var in results.pvalues else 1.0\n",
        "\n",
        "            # Determine significance stars\n",
        "            stars = \"\"\n",
        "            if pval < 0.01:\n",
        "                stars = \"***\"\n",
        "            elif pval < 0.05:\n",
        "                stars = \"**\"\n",
        "            elif pval < 0.10:\n",
        "                stars = \"*\"\n",
        "\n",
        "            # Format coefficient\n",
        "            if abs(coef) < 0.0001:  # Skip near-zero coefficients\n",
        "                continue\n",
        "\n",
        "            coef_str = f\"{abs(coef):.4f}{stars}\"\n",
        "\n",
        "            # Format variable name for display\n",
        "            if var.startswith('E_'):\n",
        "                display_var = var.replace('E_', 'E.')\n",
        "            elif var.startswith('S_'):\n",
        "                display_var = var.replace('S_', 'S.')\n",
        "            elif var.startswith('G_'):\n",
        "                display_var = var.replace('G_', 'G.')\n",
        "            elif var == 'ROA':\n",
        "                display_var = 'ROA'\n",
        "            elif var == 'Size':\n",
        "                display_var = 'Size'\n",
        "            elif var == 'Leverage':\n",
        "                display_var = 'Leverage'\n",
        "            elif var == 'ConsumerStaples':\n",
        "                display_var = 'CS_Dummy'\n",
        "            else:\n",
        "                display_var = var\n",
        "\n",
        "            if coef >= 0:\n",
        "                eq_parts.append(f\"+ {coef_str}·{display_var}\")\n",
        "            else:\n",
        "                eq_parts.append(f\"- {coef_str}·{display_var}\")\n",
        "\n",
        "    # Build equation\n",
        "    equation = \"Tobin's Q(t) = \" + \" \".join(eq_parts) + \" + ε\"\n",
        "    print(equation)\n",
        "\n",
        "    # Add R-squared and sample info\n",
        "    print(f\"\\nR² = {results.rsquared:.4f}, N = {results.nobs}\")\n",
        "\n",
        "    # Add significance legend\n",
        "    print(\"Significance: *** p<0.01, ** p<0.05, * p<0.10\")\n",
        "\n",
        "    # Add special notes if provided\n",
        "    if special_notes:\n",
        "        print(\"\\nNotes:\")\n",
        "        for note in special_notes:\n",
        "            print(f\"  • {note}\")\n",
        "\n",
        "    return equation\n",
        "\n",
