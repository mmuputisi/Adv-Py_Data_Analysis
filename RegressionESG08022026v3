        "\n",
        "# ============================================================================\n",
        "# HELPER FUNCTIONS\n",
        "# ============================================================================\n",
        "def create_decaying_avg(series, decay_rate, max_lag=3):\n",
        "    \"\"\"Create exponentially decaying weighted average\"\"\"\n",
        "    n = len(series)\n",
        "    decaying_avg = np.zeros(n)\n",
        "\n",
        "    for i in range(n):\n",
        "        total_weight = 0\n",
        "        weighted_sum = 0\n",
        "\n",
        "        for lag in range(max_lag + 1):\n",
        "            if i - lag >= 0:\n",
        "                weight = decay_rate ** lag\n",
        "                weighted_sum += weight * series.iloc[i - lag]\n",
        "                total_weight += weight\n",
        "\n",
        "        if total_weight > 0:\n",
        "            decaying_avg[i] = weighted_sum / total_weight\n",
        "\n",
        "    return decaying_avg\n",
        "\n",
        "def create_cumulative(series, depreciation=0):\n",
        "    \"\"\"Create cumulative sum with optional depreciation\"\"\"\n",
        "    cumulative = []\n",
        "    current = 0\n",
        "\n",
        "    for value in series:\n",
        "        if pd.isna(value):\n",
        "            cumulative.append(np.nan)\n",
        "        else:\n",
        "            current = (1 - depreciation) * current + value\n",
        "            cumulative.append(current)\n",
        "\n",
        "    return cumulative\n",
