        "    else:\n",
        "        analysis_df = df.copy()\n",
        "        sector_name = 'All'\n",
        "        print(\"Analyzing all sectors\")\n",
        "\n",
        "    # 1. Test Tobin's Q transformation\n",
        "    print(\"\\n\" + \"=\"*80)\n",
        "    print(\"STEP 1: TOBIN'S Q DISTRIBUTION ANALYSIS\")\n",
        "    print(\"=\"*80)\n",
        "\n",
        "    analysis_df, best_transform = analyze_tobinq_distribution(analysis_df, 'Tobin_Q')\n",
        "\n",
