        "print(\"=\"*70)\n",
        "\n",
        "# Estimate optimal decay rate by grid search using LAGGED ESG\n",
        "def objective_function_lagged(decay_rate, component='S_lag', df_data=None):\n",
        "    \"\"\"Minimize negative R-squared for different decay rates on LAGGED ESG\"\"\"\n",
        "    if df_data is None:\n",
        "        return 1e10\n",
        "\n",
        "    df_test = df_data.copy()\n",
