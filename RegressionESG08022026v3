        "def generate_regression_equation(model_name, results, variables, special_notes=None):\n",
        "    \"\"\"Generate a dynamic regression equation from model results\"\"\"\n",
        "\n",
        "    print(\"\\n\" + \"-\"*70)\n",
        "    print(f\"REGRESSION EQUATION - {model_name}:\")\n",
        "    print(\"-\"*70)\n",
        "\n",
        "    # Start with constant\n",
        "    eq_parts = []\n",
        "    if 'const' in results.params:\n",
        "        const = results.params['const']\n",
        "        # Format with proper sign\n",
        "        if const >= 0:\n",
        "            eq_parts.append(f\"{const:.4f}\")\n",
        "        else:\n",
        "            eq_parts.append(f\"- {abs(const):.4f}\")\n",
        "\n",
        "    # Add variables\n",
        "    for var in variables:\n",
        "        if var in results.params and var != 'const':\n",
        "            coef = results.params[var]\n",
        "            pval = results.pvalues[var] if var in results.pvalues else 1.0\n",
        "\n",
        "            # Determine significance stars\n",
        "            stars = \"\"\n",
        "            if pval < 0.01:\n",
        "                stars = \"***\"\n",
        "            elif pval < 0.05:\n",
        "                stars = \"**\"\n",
        "            elif pval < 0.10:\n",
        "                stars = \"*\"\n",
        "\n",
        "            # Format coefficient\n",
        "            if abs(coef) < 0.0001:  # Skip near-zero coefficients\n",
        "                continue\n",
        "\n",
        "            coef_str = f\"{abs(coef):.4f}{stars}\"\n",
        "\n",
        "            # Format variable name for display\n",
        "            if var.startswith('E_'):\n",
        "                display_var = var.replace('E_', 'E.')\n",
        "            elif var.startswith('S_'):\n",
        "                display_var = var.replace('S_', 'S.')\n",
        "            elif var.startswith('G_'):\n",
        "                display_var = var.replace('G_', 'G.')\n",
        "            elif var == 'ROA':\n",
        "                display_var = 'ROA'\n",
        "            elif var == 'Size':\n",
        "                display_var = 'Size'\n",
        "            elif var == 'Leverage':\n",
        "                display_var = 'Leverage'\n",
        "            elif var == 'ConsumerStaples':\n",
        "                display_var = 'CS_Dummy'\n",
        "            else:\n",
        "                display_var = var\n",
        "\n",
        "            if coef >= 0:\n",
        "                eq_parts.append(f\"+ {coef_str}·{display_var}\")\n",
        "            else:\n",
        "                eq_parts.append(f\"- {coef_str}·{display_var}\")\n",
        "\n",
        "    # Build equation\n",
        "    equation = \"Tobin's Q(t) = \" + \" \".join(eq_parts) + \" + ε\"\n",
        "    print(equation)\n",
        "\n",
        "    # Add R-squared and sample info\n",
        "    print(f\"\\nR² = {results.rsquared:.4f}, N = {results.nobs}\")\n",
        "\n",
        "    # Add significance legend\n",
        "    print(\"Significance: *** p<0.01, ** p<0.05, * p<0.10\")\n",
        "\n",
        "    # Add special notes if provided\n",
        "    if special_notes:\n",
        "        print(\"\\nNotes:\")\n",
        "        for note in special_notes:\n",
        "            print(f\"  • {note}\")\n",
        "\n",
        "    return equation\n",
        "\n",
        "# ============================================================================\n",
        "# ENHANCED ANALYSIS FUNCTIONS\n",
        "# ============================================================================\n",
        "def run_comprehensive_regression(df, y_var, x_vars, model_name,\n",
        "                                 entity_effects=False, time_effects=False,\n",
        "                                 cluster_by='firm', include_constant=True,\n",
        "                                 transformation=None):\n",
        "    \"\"\"Run regression with comprehensive diagnostics and multiple SE choices\"\"\"\n",
        "\n",
        "    print(f\"\\n{'='*80}\")\n",
        "    print(f\"{model_name}\")\n",
        "    print(f\"{'='*80}\")\n",
        "\n",
        "    # Prepare data\n",
        "    df_clean = df.dropna(subset=[y_var] + x_vars)\n",
        "\n",
        "    if len(df_clean) < 10:\n",
        "        print(f\"Insufficient data: {len(df_clean)} observations\")\n",
        "        return None\n",
        "\n",
        "    y = df_clean[y_var]\n",
        "    X = df_clean[x_vars]\n",
        "\n",
        "    if include_constant:\n",
        "        X = pd.concat([pd.Series(1, index=X.index, name='const'), X], axis=1)\n",
        "\n",
        "    # Run different specifications with different SE\n",
        "    results_dict = {}\n",
        "\n",
        "    # Standard errors to try\n",
        "    se_methods = ['robust', 'clustered', 'unadjusted']\n",
        "\n",
        "    for se_method in se_methods:\n",
        "        try:\n",
        "            if se_method == 'clustered':\n",
        "                # Firm-clustered standard errors\n",
        "                model = PanelOLS(y, X, entity_effects=entity_effects,\n",
        "                                time_effects=time_effects)\n",
        "                results = model.fit(cov_type='clustered',\n",
        "                                   cluster_entity=True)\n",
        "            else:\n",
        "                model = PanelOLS(y, X, entity_effects=entity_effects,\n",
        "                                time_effects=time_effects)\n",
        "                results = model.fit(cov_type=se_method)\n",
        "\n",
        "            results_dict[se_method] = results\n",
        "\n",
        "            print(f\"\\n{se_method.upper()} Standard Errors:\")\n",
        "            print(f\"R-squared: {results.rsquared:.4f}\")\n",
        "            print(f\"Observations: {results.nobs}\")\n",
        "            print(f\"F-statistic: {results.f_statistic.stat:.4f} (p={results.f_statistic.pval:.4f})\")\n",
        "\n",
        "        except Exception as e:\n",
        "            print(f\"Failed to run with {se_method} SE: {str(e)}\")\n",
        "\n",
        "    return results_dict\n",
        "\n",
        "def test_fe_structure(df, y_var, x_vars, entity_var='Firm', time_var='Year'):\n",
        "    \"\"\"Test FE structure using Hausman and F-tests\"\"\"\n",
        "    print(f\"\\n{'='*80}\")\n",
        "    print(\"FIXED EFFECTS STRUCTURE TESTING\")\n",
        "    print(f\"{'='*80}\")\n",
        "\n",
        "    # Reset index for statsmodels\n",
        "    df_reset = df.reset_index()\n",
        "\n",
        "    # Prepare data\n",
        "    y = df_reset[y_var]\n",
        "    X = df_reset[x_vars]\n",
        "    X = sm.add_constant(X)\n",
        "\n",
        "    # Pooled OLS (no FE)\n",
        "    pooled = sm.OLS(y, X).fit(cov_type='HC1')\n",
        "\n",
        "    # Entity FE using statsmodels\n",
        "    entity_dummies = pd.get_dummies(df_reset[entity_var], prefix='firm', drop_first=True)\n",
        "    X_fe = pd.concat([X, entity_dummies], axis=1)\n",
        "    fe_entity = sm.OLS(y, X_fe).fit(cov_type='HC1')\n",
        "\n",
        "    # Time FE\n",
        "    time_dummies = pd.get_dummies(df_reset[time_var], prefix='year', drop_first=True)\n",
        "    X_timefe = pd.concat([X, time_dummies], axis=1)\n",
        "    fe_time = sm.OLS(y, X_timefe).fit(cov_type='HC1')\n",
        "\n",
        "    # Two-way FE\n",
        "    X_twoway = pd.concat([X, entity_dummies, time_dummies], axis=1)\n",
        "    fe_twoway = sm.OLS(y, X_twoway).fit(cov_type='HC1')\n",
        "\n",
        "    # F-tests for FE significance\n",
        "    print(\"\\nF-TESTS FOR FIXED EFFECTS:\")\n",
        "    print(\"-\" * 50)\n",
        "\n",
        "    # Test entity FE vs pooled\n",
        "    ssr_pooled = pooled.ssr\n",
        "    ssr_fe = fe_entity.ssr\n",
        "    n_entities = df_reset[entity_var].nunique() - 1\n",
        "    n_obs = len(y)\n",
        "    k = len(x_vars) + 1  # +1 for constant\n",
        "\n",
        "    f_stat_entity = ((ssr_pooled - ssr_fe) / n_entities) / (ssr_fe / (n_obs - k - n_entities))\n",
        "    p_val_entity = 1 - stats.f.cdf(f_stat_entity, n_entities, n_obs - k - n_entities)\n",
        "\n",
        "    print(f\"Entity FE vs Pooled:\")\n",
        "    print(f\"  F-statistic: {f_stat_entity:.4f}\")\n",
        "    print(f\"  p-value: {p_val_entity:.4f}\")\n",
        "    print(f\"  Conclusion: {'Entity FE preferred' if p_val_entity < 0.05 else 'Pooled OLS preferred'}\")\n",
        "\n",
        "    # Test time FE vs pooled\n",
        "    ssr_time = fe_time.ssr\n",
        "    n_time = df_reset[time_var].nunique() - 1\n",
        "    f_stat_time = ((ssr_pooled - ssr_time) / n_time) / (ssr_time / (n_obs - k - n_time))\n",
        "    p_val_time = 1 - stats.f.cdf(f_stat_time, n_time, n_obs - k - n_time)\n",
        "\n",
        "    print(f\"\\nTime FE vs Pooled:\")\n",
        "    print(f\"  F-statistic: {f_stat_time:.4f}\")\n",
        "    print(f\"  p-value: {p_val_time:.4f}\")\n",
        "    print(f\"  Conclusion: {'Time FE preferred' if p_val_time < 0.05 else 'Pooled OLS preferred'}\")\n",
        "\n",
        "    # Test two-way FE vs pooled\n",
        "    n_total_dummies = n_entities + n_time\n",
        "    ssr_twoway = fe_twoway.ssr\n",
        "    f_stat_twoway = ((ssr_pooled - ssr_twoway) / n_total_dummies) / (ssr_twoway / (n_obs - k - n_total_dummies))\n",
        "    p_val_twoway = 1 - stats.f.cdf(f_stat_twoway, n_total_dummies, n_obs - k - n_total_dummies)\n",
        "\n",
        "    print(f\"\\nTwo-way FE vs Pooled:\")\n",
        "    print(f\"  F-statistic: {f_stat_twoway:.4f}\")\n",
        "    print(f\"  p-value: {p_val_twoway:.4f}\")\n",
        "    print(f\"  Conclusion: {'Two-way FE preferred' if p_val_twoway < 0.05 else 'Pooled OLS preferred'}\")\n",
        "\n",
        "    # Simplified Hausman test (FE vs RE)\n",
        "    print(\"\\n\" + \"=\"*50)\n",
        "    print(\"HAUSMAN-TYPE TEST (FE vs RE GUIDANCE):\")\n",
        "    print(\"=\"*50)\n",
        "    print(\"Note: Formal Hausman test requires random effects model\")\n",
        "    print(\"\\nDecision Rules:\")\n",
        "    print(\"1. If entity F-test significant (p < 0.05): Use entity FE\")\n",
        "    print(\"2. If time F-test significant (p < 0.05): Use time FE\")\n",
        "    print(\"3. If both significant: Use two-way FE\")\n",
        "    print(\"4. If neither significant: Pooled OLS may be sufficient\")\n",
        "\n",
        "    # Recommendation\n",
        "    print(\"\\n\" + \"=\"*50)\n",
        "    print(\"RECOMMENDED SPECIFICATION:\")\n",
        "    print(\"=\"*50)\n",
        "\n",
        "    if p_val_entity < 0.05 and p_val_time < 0.05:\n",
        "        print(\"Two-way Fixed Effects (firm and year)\")\n",
        "        recommendation = 'two-way'\n",
        "    elif p_val_entity < 0.05:\n",
        "        print(\"Entity Fixed Effects\")\n",
        "        recommendation = 'entity'\n",
        "    elif p_val_time < 0.05:\n",
        "        print(\"Time Fixed Effects\")\n",
        "        recommendation = 'time'\n",
        "    else:\n",
        "        print(\"Pooled OLS (no fixed effects)\")\n",
        "        recommendation = 'pooled'\n",
        "\n",
        "    return recommendation\n",
        "\n",
        "def analyze_tobinq_distribution(df, tobinq_var='Tobin_Q'):\n",
        "    \"\"\"Analyze and transform Tobin's Q for potential right skewness\"\"\"\n",
        "    print(f\"\\n{'='*80}\")\n",
        "    print(\"TOBIN'S Q DISTRIBUTION ANALYSIS\")\n",
        "    print(f\"{'='*80}\")\n",
        "\n",
        "    tobinq_data = df[tobinq_var].dropna()\n",
        "\n",
        "    # Original distribution\n",
        "    print(\"\\nORIGINAL DISTRIBUTION:\")\n",
        "    print(f\"Mean: {tobinq_data.mean():.4f}\")\n",
        "    print(f\"Median: {tobinq_data.median():.4f}\")\n",
        "    print(f\"Std Dev: {tobinq_data.std():.4f}\")\n",
        "    print(f\"Skewness: {stats.skew(tobinq_data):.4f}\")\n",
        "    print(f\"Kurtosis: {stats.kurtosis(tobinq_data):.4f}\")\n",
        "\n",
        "    # Shapiro-Wilk test for normality\n",
        "    shapiro_stat, shapiro_p = shapiro(tobinq_data)\n",
        "    print(f\"Shapiro-Wilk test p-value: {shapiro_p:.6f}\")\n",
        "    print(f\"Normality: {'Rejected' if shapiro_p < 0.05 else 'Not rejected'}\")\n",
        "\n",
        "    # Plot original distribution\n",
        "    fig, axes = plt.subplots(1, 2, figsize=(12, 4))\n",
        "\n",
        "    # Histogram\n",
        "    axes[0].hist(tobinq_data, bins=30, edgecolor='black', alpha=0.7)\n",
        "    axes[0].axvline(tobinq_data.mean(), color='red', linestyle='--', label=f'Mean: {tobinq_data.mean():.2f}')\n",
        "    axes[0].axvline(tobinq_data.median(), color='green', linestyle='--', label=f'Median: {tobinq_data.median():.2f}')\n",
        "    axes[0].set_xlabel('Tobin\\'s Q')\n",
        "    axes[0].set_ylabel('Frequency')\n",
        "    axes[0].set_title('Original Tobin\\'s Q Distribution')\n",
        "    axes[0].legend()\n",
        "    axes[0].grid(True, alpha=0.3)\n",
        "\n",
        "    # Q-Q plot\n",
        "    stats.probplot(tobinq_data, dist=\"norm\", plot=axes[1])\n",
        "    axes[1].set_title('Q-Q Plot (Original)')\n",
        "    axes[1].grid(True, alpha=0.3)\n",
        "\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "\n",
        "    # Test transformations\n",
        "    transformations = {\n",
        "        'log': np.log(tobinq_data + 1 - tobinq_data.min()),  # Log transformation\n",
        "        'sqrt': np.sqrt(tobinq_data),  # Square root\n",
        "        'inverse': 1 / (tobinq_data + 1),  # Inverse\n",
        "        'boxcox': None  # Will calculate below\n",
        "    }\n",
        "\n",
        "    # Box-Cox transformation (requires positive values)\n",
        "    if (tobinq_data > 0).all():\n",
        "        try:\n",
        "            transformed_data, lambda_val = stats.boxcox(tobinq_data)\n",
        "            transformations['boxcox'] = transformed_data\n",
        "            print(f\"\\nBox-Cox lambda: {lambda_val:.4f}\")\n",
        "        except:\n",
        "            pass\n",
        "\n",
        "    print(f\"\\n{'='*50}\")\n",
        "    print(\"TRANSFORMATION COMPARISON:\")\n",
        "    print(f\"{'='*50}\")\n",
        "    print(f\"{'Transformation':<15} {'Skewness':<15} {'K-S Normality p-value':<20}\")\n",
        "    print(\"-\" * 50)\n",
        "\n",
        "    best_transform = None\n",
        "    best_skewness = float('inf')\n",
        "\n",
        "    for name, data in transformations.items():\n",
        "        if data is not None:\n",
        "            # Calculate skewness\n",
        "            current_skewness = abs(stats.skew(data))\n",
        "\n",
        "            # Kolmogorov-Smirnov test for normality\n",
        "            ks_stat, ks_p = stats.kstest(data, 'norm',\n",
        "                                        args=(data.mean(), data.std()))\n",
        "\n",
        "            print(f\"{name:<15} {current_skewness:<15.4f} {ks_p:<20.6f}\")\n",
        "\n",
        "            if current_skewness < best_skewness:\n",
        "                best_skewness = current_skewness\n",
        "                best_transform = name\n",
        "\n",
        "    print(f\"\\nRecommended transformation: {best_transform}\")\n",
        "\n",
        "    # Apply best transformation\n",
        "    if best_transform == 'log':\n",
        "        df[f'{tobinq_var}_transformed'] = np.log(df[tobinq_var] + 1 - df[tobinq_var].min())\n",
        "    elif best_transform == 'sqrt':\n",
        "        df[f'{tobinq_var}_transformed'] = np.sqrt(df[tobinq_var])\n",
        "    elif best_transform == 'inverse':\n",
        "        df[f'{tobinq_var}_transformed'] = 1 / (df[tobinq_var] + 1)\n",
        "    elif best_transform == 'boxcox' and (df[tobinq_var] > 0).all():\n",
        "        transformed, _ = stats.boxcox(df[tobinq_var])\n",
        "        df[f'{tobinq_var}_transformed'] = transformed\n",
        "\n",
        "    return df, best_transform\n",
