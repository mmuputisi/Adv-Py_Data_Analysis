      "source": [
        "# standalone_lag_model.py\n",
        "\"\"\"\n",
        "Standalone Lag Model Analysis\n",
        "Focus: Distributed lag models (1-5 years) with flexibility\n",
        "\"\"\"\n",
        "\n",
        "# ============================================================================\n",
        "# SETUP AND IMPORTS\n",
        "# ============================================================================\n",
        "from google.colab import drive\n",
        "drive.mount('/content/drive')\n",
        "\n",
        "!pip install -q linearmodels pandas numpy matplotlib seaborn statsmodels scikit-learn\n",
        "\n",
        "import os\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "from linearmodels.panel import PanelOLS\n",
        "import statsmodels.api as sm\n",
        "from scipy import stats\n",
        "import warnings\n",
        "warnings.filterwarnings('ignore')\n",
        "\n",
        "# ============================================================================\n",
        "# CONFIGURATION\n",
        "# ============================================================================\n",
        "class Config:\n",
        "    \"\"\"Configuration parameters for the lag model analysis\"\"\"\n",
        "    # Data paths\n",
        "    PROJECT_DIR = '/content/drive/MyDrive/Colab Notebooks/FTSE Data'\n",
        "    DATA_PATH = os.path.join(PROJECT_DIR, 'FTSE data.xlsx')\n",
        "    OUTPUT_DIR = os.path.join(PROJECT_DIR, 'lag_model_outputs')\n",
        "\n",
        "    # Model settings\n",
        "    MIN_LAG = 1\n",
        "    MAX_LAG = 5  # Can be changed to 2, 3, 4, or 5\n",
        "    CONTROL_VARS = ['ROA', 'Size', 'Leverage']\n",
        "    ESG_COMPONENTS = ['E', 'S', 'G']\n",
        "\n",
        "    # Output settings\n",
        "    SAVE_RESULTS = True\n",
        "    CREATE_PLOTS = True\n",
        "\n",
        "# ============================================================================\n",
        "# DATA LOADING AND PREPARATION\n",
        "# ============================================================================\n",
        "class DataLoader:\n",
        "    \"\"\"Load and prepare data for lag model analysis\"\"\"\n",
        "\n",
        "    def __init__(self, config):\n",
        "        self.config = config\n",
        "        self.df = None\n",
        "\n",
        "    def load_data(self):\n",
        "        \"\"\"Load and clean the dataset\"\"\"\n",
        "        print(f\"Loading data from: {self.config.DATA_PATH}\")\n",
        "\n",
        "        # Load Excel file\n",
        "        self.df = pd.read_excel(self.config.DATA_PATH)\n",
        "\n",
        "        # Set multi-index\n",
        "        self.df = self.df.set_index(['Firm', 'Year']).sort_index()\n",
        "\n",
        "        # Rename Tobin's Q column\n",
        "        self.df = self.df.rename(columns={\"Tobin's Q\": \"Tobin_Q\"})\n",
        "\n",
        "        # Create transformed variables\n",
        "        self.df['Size'] = np.log(self.df['Total Assets'])\n",
        "        self.df['Leverage'] = self.df['Total Liabilities'] / self.df['Total Assets']\n",
        "        self.df['Tobin_Q_log'] = np.log(self.df['Tobin_Q'] + 0.001)\n",
        "\n",
        "        print(f\"✓ Loaded {len(self.df)} observations\")\n",
        "        print(f\"✓ {self.df.index.get_level_values(0).nunique()} unique firms\")\n",
        "\n",
        "        return self.df\n",
        "\n",
        "    def create_lagged_variables(self, max_lag=5):\n",
        "        \"\"\"Create lagged ESG variables\"\"\"\n",
        "        print(f\"\\nCreating lagged variables (lags 1-{max_lag})...\")\n",
        "\n",
        "        # Create lagged ESG variables\n",
        "        for component in self.config.ESG_COMPONENTS:\n",
        "            for lag in range(1, max_lag + 1):\n",
        "                self.df[f'{component}_lag{lag}'] = self.df.groupby(level=0)[component].shift(lag)\n",
        "\n",
        "        # Create lagged control variables\n",
        "        for var in ['ROA', 'Size', 'Leverage']:\n",
        "            self.df[f'{var}_lag'] = self.df.groupby(level=0)[var].shift(1)\n",
        "\n",
        "        print(f\"✓ Created lagged variables for lags 1-{max_lag}\")\n",
        "        return self.df\n",
        "\n",
        "# ============================================================================\n",
        "# LAG MODEL ANALYSIS\n",
        "# ============================================================================\n",
        "class LagModelAnalyzer:\n",
        "    \"\"\"Analyze distributed lag models\"\"\"\n",
        "\n",
        "    def __init__(self, df, config):\n",
        "        self.df = df\n",
        "        self.config = config\n",
        "        self.results = {}\n",
        "\n",
        "    def run_distributed_lag_model(self, min_lag=1, max_lag=5, sector='all',\n",
        "                                  y_var='Tobin_Q', entity_effects=False,\n",
        "                                  time_effects=False):\n",
        "        \"\"\"\n",
        "        Run distributed lag model with specified lag range\n",
        "\n",
        "        Parameters:\n",
        "        -----------\n",
        "        min_lag : int\n",
        "            Minimum lag (usually 1)\n",
        "        max_lag : int\n",
        "            Maximum lag (1-5)\n",
        "        sector : str\n",
        "            'all' for all sectors, 'cs' for Consumer Staples only\n",
        "        y_var : str\n",
        "            Dependent variable ('Tobin_Q' or 'Tobin_Q_log')\n",
        "        entity_effects : bool\n",
        "            Whether to include entity fixed effects\n",
        "        time_effects : bool\n",
        "            Whether to include time fixed effects\n",
        "        \"\"\"\n",
        "        # Filter data by sector if needed\n",
        "        if sector.lower() == 'cs':\n",
        "            analysis_df = self.df[self.df['ConsumerStaples'] == 1].copy()\n",
        "            sector_name = 'Consumer Staples'\n",
        "        else:\n",
        "            analysis_df = self.df.copy()\n",
        "            sector_name = 'All Sectors'\n",
        "\n",
        "        # Prepare lag variables\n",
        "        lag_vars = []\n",
        "        for component in self.config.ESG_COMPONENTS:\n",
        "            for lag in range(min_lag, max_lag + 1):\n",
        "                lag_vars.append(f'{component}_lag{lag}')\n",
        "\n",
        "        # Use lagged controls\n",
        "        control_vars = [f'{var}_lag' for var in self.config.CONTROL_VARS]\n",
        "\n",
        "        # Add sector dummy for all sectors analysis\n",
        "        if sector == 'all':\n",
        "            control_vars = control_vars + ['ConsumerStaples']\n",
        "\n",
        "        # Prepare data\n",
        "        all_vars = lag_vars + control_vars + [y_var]\n",
        "        df_clean = analysis_df.dropna(subset=all_vars)\n",
        "\n",
        "        if len(df_clean) < 10:\n",
        "            print(f\"⚠ Insufficient data: {len(df_clean)} observations\")\n",
        "            return None\n",
        "\n",
        "        print(f\"\\n{'='*60}\")\n",
        "        print(f\"DISTRIBUTED LAG MODEL: Lags {min_lag}-{max_lag}\")\n",
        "        print(f\"Sector: {sector_name}\")\n",
        "        print(f\"Dependent: {y_var}\")\n",
        "        print(f\"Observations: {len(df_clean)}\")\n",
        "        print(f\"Firms: {df_clean.index.get_level_values(0).nunique()}\")\n",
        "        print(f\"{'='*60}\")\n",
        "\n",
        "        # Prepare regression variables\n",
        "        y = df_clean[y_var]\n",
        "        X = df_clean[lag_vars + control_vars]\n",
        "        X = pd.concat([pd.Series(1, index=X.index, name='const'), X], axis=1)\n",
        "\n",
        "        # Run regression\n",
        "        try:\n",
        "            model = PanelOLS(y, X,\n",
        "                           entity_effects=entity_effects,\n",
        "                           time_effects=time_effects)\n",
        "\n",
        "            if entity_effects:\n",
        "                results = model.fit(cov_type='clustered', cluster_entity=True)\n",
        "            else:\n",
        "                results = model.fit(cov_type='robust')\n",
        "\n",
        "            # Store results\n",
        "            model_key = f\"lag{min_lag}_{max_lag}_{sector}_{y_var}\"\n",
        "            self.results[model_key] = {\n",
        "                'results': results,\n",
        "                'model': model,\n",
        "                'y_var': y_var,\n",
        "                'sector': sector,\n",
        "                'min_lag': min_lag,\n",
        "                'max_lag': max_lag,\n",
        "                'nobs': results.nobs,\n",
        "                'r2': results.rsquared,\n",
        "                'entity_effects': entity_effects,\n",
        "                'time_effects': time_effects,\n",
        "                'data': df_clean\n",
        "            }\n",
        "\n",
        "            return results\n",
        "\n",
        "        except Exception as e:\n",
        "            print(f\"Error running model: {e}\")\n",
        "            return None\n",
        "\n",
        "    def run_cumulative_lag_model(self, min_lag=1, max_lag=5, sector='all',\n",
        "                                y_var='Tobin_Q', entity_effects=False,\n",
        "                                time_effects=False):\n",
        "        \"\"\"\n",
        "        Run cumulative lag model (sum of lagged effects)\n",
        "        \"\"\"\n",
        "        # Filter data by sector\n",
        "        if sector.lower() == 'cs':\n",
        "            analysis_df = self.df[self.df['ConsumerStaples'] == 1].copy()\n",
        "            sector_name = 'Consumer Staples'\n",
        "        else:\n",
        "            analysis_df = self.df.copy()\n",
        "            sector_name = 'All Sectors'\n",
        "\n",
        "        # Create cumulative lag variables\n",
        "        for component in self.config.ESG_COMPONENTS:\n",
        "            # Initialize cumulative variable\n",
        "            analysis_df[f'{component}_cumulative'] = 0\n",
        "\n",
        "            # Sum across specified lags\n",
        "            for lag in range(min_lag, max_lag + 1):\n",
        "                lag_var = f'{component}_lag{lag}'\n",
        "                if lag_var in analysis_df.columns:\n",
        "                    analysis_df[f'{component}_cumulative'] += analysis_df[lag_var]\n",
        "\n",
        "        # Prepare variables\n",
        "        cumulative_vars = [f'{component}_cumulative' for component in self.config.ESG_COMPONENTS]\n",
        "        control_vars = [f'{var}_lag' for var in self.config.CONTROL_VARS]\n",
        "\n",
        "        if sector == 'all':\n",
        "            control_vars = control_vars + ['ConsumerStaples']\n",
        "\n",
        "        # Clean data\n",
        "        all_vars = cumulative_vars + control_vars + [y_var]\n",
        "        df_clean = analysis_df.dropna(subset=all_vars)\n",
        "\n",
        "        if len(df_clean) < 10:\n",
        "            print(f\"⚠ Insufficient data: {len(df_clean)} observations\")\n",
        "            return None\n",
        "\n",
        "        print(f\"\\n{'='*60}\")\n",
        "        print(f\"CUMULATIVE LAG MODEL: Sum of Lags {min_lag}-{max_lag}\")\n",
        "        print(f\"Sector: {sector_name}\")\n",
        "        print(f\"Dependent: {y_var}\")\n",
        "        print(f\"Observations: {len(df_clean)}\")\n",
        "        print(f\"{'='*60}\")\n",
        "\n",
        "        # Run regression\n",
        "        y = df_clean[y_var]\n",
        "        X = df_clean[cumulative_vars + control_vars]\n",
        "        X = pd.concat([pd.Series(1, index=X.index, name='const'), X], axis=1)\n",
        "\n",
        "        try:\n",
        "            model = PanelOLS(y, X,\n",
        "                           entity_effects=entity_effects,\n",
        "                           time_effects=time_effects)\n",
        "\n",
        "            if entity_effects:\n",
        "                results = model.fit(cov_type='clustered', cluster_entity=True)\n",
        "            else:\n",
        "                results = model.fit(cov_type='robust')\n",
        "\n",
        "            # Store results\n",
        "            model_key = f\"cumulative_{min_lag}_{max_lag}_{sector}_{y_var}\"\n",
        "            self.results[model_key] = {\n",
        "                'results': results,\n",
        "                'model': model,\n",
        "                'y_var': y_var,\n",
        "                'sector': sector,\n",
        "                'min_lag': min_lag,\n",
        "                'max_lag': max_lag,\n",
        "                'nobs': results.nobs,\n",
        "                'r2': results.rsquared,\n",
        "                'entity_effects': entity_effects,\n",
        "                'time_effects': time_effects,\n",
        "                'data': df_clean\n",
        "            }\n",
        "\n",
        "            return results\n",
        "\n",
        "        except Exception as e:\n",
        "            print(f\"Error running model: {e}\")\n",
        "            return None\n",
        "\n",
        "    def print_model_results(self, results, model_name):\n",
        "        \"\"\"Print formatted model results\"\"\"\n",
        "        if results is None:\n",
        "            print(\"No results to display\")\n",
        "            return\n",
        "\n",
        "        print(f\"\\n{model_name}\")\n",
        "        print(\"-\" * 60)\n",
        "        print(f\"R-squared: {results.rsquared:.4f}\")\n",
        "        print(f\"Observations: {results.nobs}\")\n",
        "\n",
        "        if hasattr(results, 'f_statistic'):\n",
        "            print(f\"F-statistic: {results.f_statistic.stat:.4f} (p={results.f_statistic.pval:.4f})\")\n",
        "\n",
        "        # Print ESG coefficients\n",
        "        print(\"\\nESG Coefficients:\")\n",
        "        print(\"-\" * 40)\n",
        "\n",
        "        for component in self.config.ESG_COMPONENTS:\n",
        "            component_coeffs = []\n",
        "            for var in results.params.index:\n",
        "                if component in var:\n",
        "                    coeff = results.params[var]\n",
        "                    pval = results.pvalues.get(var, 1.0)\n",
        "                    sig = \"***\" if pval < 0.01 else \"**\" if pval < 0.05 else \"*\" if pval < 0.10 else \"\"\n",
        "                    component_coeffs.append((var, coeff, pval, sig))\n",
        "\n",
        "            if component_coeffs:\n",
        "                print(f\"\\n{component} component:\")\n",
        "                for var, coeff, pval, sig in component_coeffs:\n",
        "                    print(f\"  {var:<15} {coeff:>10.4f}{sig:<3} (p={pval:.4f})\")\n",
        "\n",
        "    def plot_lag_structure(self, results, min_lag=1, max_lag=5):\n",
        "        \"\"\"Create lag structure plot for ESG components\"\"\"\n",
        "        if results is None:\n",
        "            print(\"No results to plot\")\n",
        "            return\n",
        "\n",
        "        fig, axes = plt.subplots(1, 3, figsize=(15, 4))\n",
        "        fig.suptitle(f'Lag Structure: Lags {min_lag}-{max_lag}', fontsize=14, fontweight='bold')\n",
        "\n",
        "        for idx, component in enumerate(self.config.ESG_COMPONENTS):\n",
        "            lags = list(range(min_lag, max_lag + 1))\n",
        "            coeffs = []\n",
        "            errors = []\n",
        "\n",
        "            for lag in lags:\n",
        "                var = f'{component}_lag{lag}'\n",
        "                if var in results.params:\n",
        "                    coeffs.append(results.params[var])\n",
        "                    if hasattr(results, 'std_errors') and var in results.std_errors:\n",
        "                        errors.append(results.std_errors[var])\n",
        "                    else:\n",
        "                        errors.append(0)\n",
        "                else:\n",
        "                    coeffs.append(0)\n",
        "                    errors.append(0)\n",
        "\n",
        "            axes[idx].errorbar(lags, coeffs, yerr=errors, fmt='o-',\n",
        "                             capsize=5, linewidth=2, markersize=8)\n",
        "            axes[idx].axhline(y=0, color='r', linestyle='--', alpha=0.5)\n",
        "            axes[idx].set_xlabel('Years Lag')\n",
        "            axes[idx].set_ylabel('Coefficient')\n",
        "            axes[idx].set_title(f'{component} Component')\n",
        "            axes[idx].set_xticks(lags)\n",
        "            axes[idx].grid(True, alpha=0.3)\n",
        "\n",
        "            # Add significance markers\n",
        "            for lag_idx, lag in enumerate(lags):\n",
        "                var = f'{component}_lag{lag}'\n",
        "                if var in results.pvalues:\n",
        "                    pval = results.pvalues[var]\n",
        "                    if pval < 0.10:\n",
        "                        axes[idx].plot(lag, coeffs[lag_idx], 'o', markersize=10,\n",
        "                                     markeredgecolor='red', markeredgewidth=2,\n",
        "                                     markerfacecolor='none')\n",
        "\n",
        "        plt.tight_layout()\n",
        "        return fig\n",
        "\n",
        "# ============================================================================\n",
        "# RESULTS SUMMARIZER\n",
        "# ============================================================================\n",
        "class ResultsSummarizer:\n",
        "    \"\"\"Summarize and compare lag model results\"\"\"\n",
        "\n",
        "    def __init__(self, analyzer):\n",
        "        self.analyzer = analyzer\n",
        "        self.summary_df = None\n",
        "\n",
        "    def create_summary_table(self):\n",
        "        \"\"\"Create summary table of all model results\"\"\"\n",
        "        summary_data = []\n",
        "\n",
        "        for model_key, model_info in self.analyzer.results.items():\n",
        "            results = model_info['results']\n",
        "\n",
        "            # Extract key statistics\n",
        "            row = {\n",
        "                'Model': model_key,\n",
        "                'Sector': model_info['sector'],\n",
        "                'Y_Var': model_info['y_var'],\n",
        "                'Min_Lag': model_info['min_lag'],\n",
        "                'Max_Lag': model_info['max_lag'],\n",
        "                'N': results.nobs,\n",
        "                'R2': results.rsquared,\n",
        "                'Entity_FE': model_info['entity_effects'],\n",
        "                'Time_FE': model_info['time_effects']\n",
        "            }\n",
        "\n",
        "            # Extract ESG coefficients\n",
        "            for component in self.analyzer.config.ESG_COMPONENTS:\n",
        "                component_vars = [v for v in results.params.index if component in str(v)]\n",
        "                if component_vars:\n",
        "                    # Get average coefficient (for cumulative models)\n",
        "                    if 'cumulative' in model_key:\n",
        "                        var = f'{component}_cumulative'\n",
        "                        if var in results.params:\n",
        "                            row[f'{component}_coeff'] = results.params[var]\n",
        "                            row[f'{component}_pval'] = results.pvalues.get(var, 1.0)\n",
        "                    else:\n",
        "                        # For distributed lags, show range\n",
        "                        coeffs = [results.params[v] for v in component_vars if v in results.params]\n",
        "                        if coeffs:\n",
        "                            row[f'{component}_min'] = min(coeffs)\n",
        "                            row[f'{component}_max'] = max(coeffs)\n",
        "                            row[f'{component}_avg'] = np.mean(coeffs)\n",
        "\n",
        "            summary_data.append(row)\n",
        "\n",
        "        self.summary_df = pd.DataFrame(summary_data)\n",
        "        return self.summary_df\n",
        "\n",
        "    def print_comparison(self):\n",
        "        \"\"\"Print comparison of different lag specifications\"\"\"\n",
        "        if self.summary_df is None:\n",
        "            self.create_summary_table()\n",
        "\n",
        "        print(\"\\n\" + \"=\"*80)\n",
        "        print(\"LAG MODEL COMPARISON\")\n",
        "        print(\"=\"*80)\n",
        "\n",
        "        # Group by model type and sector\n",
        "        for sector in ['all', 'cs']:\n",
        "            sector_df = self.summary_df[self.summary_df['Sector'] == sector]\n",
        "\n",
        "            if len(sector_df) > 0:\n",
        "                print(f\"\\n{sector.upper()} SECTORS:\")\n",
        "                print(\"-\" * 60)\n",
        "\n",
        "                # Sort by R2\n",
        "                sector_df = sector_df.sort_values('R2', ascending=False)\n",
        "\n",
        "                for _, row in sector_df.iterrows():\n",
        "                    model_type = \"Cumulative\" if \"cumulative\" in row['Model'] else \"Distributed\"\n",
        "                    print(f\"\\n{model_type} Model (Lags {row['Min_Lag']}-{row['Max_Lag']}):\")\n",
        "                    print(f\"  R² = {row['R2']:.4f}, N = {row['N']}\")\n",
        "\n",
        "                    # Show key coefficients\n",
        "                    for component in self.analyzer.config.ESG_COMPONENTS:\n",
        "                        if f'{component}_coeff' in row and not pd.isna(row[f'{component}_coeff']):\n",
        "                            coeff = row[f'{component}_coeff']\n",
        "                            pval = row.get(f'{component}_pval', 1.0)\n",
        "                            sig = \"***\" if pval < 0.01 else \"**\" if pval < 0.05 else \"*\" if pval < 0.10 else \"\"\n",
        "                            print(f\"  {component}: {coeff:.4f}{sig}\")\n",
        "\n",
        "    def save_results(self, output_dir):\n",
        "        \"\"\"Save all results to Excel\"\"\"\n",
        "        if self.summary_df is None:\n",
        "            self.create_summary_table()\n",
        "\n",
        "        os.makedirs(output_dir, exist_ok=True)\n",
        "        output_file = os.path.join(output_dir, 'lag_model_results.xlsx')\n",
        "\n",
        "        with pd.ExcelWriter(output_file, engine='openpyxl') as writer:\n",
        "            # Save summary table\n",
        "            self.summary_df.to_excel(writer, sheet_name='Summary', index=False)\n",
        "\n",
        "            # Save detailed results for each model\n",
        "            for model_key, model_info in self.analyzer.results.items():\n",
        "                results = model_info['results']\n",
        "\n",
        "                # Create coefficient table\n",
        "                coeff_df = pd.DataFrame({\n",
        "                    'Variable': results.params.index,\n",
        "                    'Coefficient': results.params.values,\n",
        "                    'Std_Error': [results.std_errors.get(v, np.nan) for v in results.params.index],\n",
        "                    'P_Value': [results.pvalues.get(v, np.nan) for v in results.params.index]\n",
        "                })\n",
        "\n",
        "                # Shorten sheet name if needed\n",
        "                sheet_name = model_key[:31]  # Excel limit\n",
        "                coeff_df.to_excel(writer, sheet_name=sheet_name, index=False)\n",
        "\n",
        "        print(f\"\\n✓ Results saved to: {output_file}\")\n",
        "\n",
        "# ============================================================================\n",
        "# MAIN EXECUTION FUNCTION\n",
        "# ============================================================================\n",
        "def main():\n",
        "    \"\"\"Main execution function\"\"\"\n",
        "    print(\"\\n\" + \"=\"*80)\n",
        "    print(\"STANDALONE LAG MODEL ANALYSIS\")\n",
        "    print(\"=\"*80)\n",
        "\n",
        "    # Initialize configuration\n",
        "    config = Config()\n",
        "\n",
        "    # Create output directory\n",
        "    os.makedirs(config.OUTPUT_DIR, exist_ok=True)\n",
        "\n",
        "    # Load data\n",
        "    print(\"\\n1. LOADING DATA\")\n",
        "    print(\"-\" * 40)\n",
        "    data_loader = DataLoader(config)\n",
        "    df = data_loader.load_data()\n",
        "\n",
        "    # Define Consumer Staples firms\n",
        "    consumer_staples_firms = [\n",
        "        'Associated British Foods', 'British American Tobacco', 'Coca Cola HBC AG',\n",
        "        'Diageo', 'J. Sainsbury', 'Reckitt Benckiser', 'Tesco', 'Unilever', 'Haleon Plc'\n",
        "    ]\n",
        "\n",
        "    # Create sector variable\n",
        "    df['Sector'] = 'Other'\n",
        "    for firm in consumer_staples_firms:\n",
        "        df.loc[df.index.get_level_values(0) == firm, 'Sector'] = 'Consumer Staples'\n",
        "\n",
        "    df['ConsumerStaples'] = (df['Sector'] == 'Consumer Staples').astype(int)\n",
        "\n",
        "    # Create lagged variables\n",
        "    print(\"\\n2. CREATING LAGGED VARIABLES\")\n",
        "    print(\"-\" * 40)\n",
        "    df = data_loader.create_lagged_variables(max_lag=config.MAX_LAG)\n",
        "\n",
        "    # Initialize analyzer\n",
        "    print(\"\\n3. RUNNING LAG MODELS\")\n",
        "    print(\"-\" * 40)\n",
        "    analyzer = LagModelAnalyzer(df, config)\n",
        "\n",
        "    # Run models with different specifications\n",
        "    lag_specifications = [\n",
        "        (1, 2),  # 1-2 year lags\n",
        "        (1, 3),  # 1-3 year lags\n",
        "        (1, 4),  # 1-4 year lags\n",
        "        (1, 5),  # 1-5 year lags\n",
        "    ]\n",
        "\n",
        "    # Only run up to configured max lag\n",
        "    lag_specifications = [spec for spec in lag_specifications\n",
        "                         if spec[1] <= config.MAX_LAG]\n",
        "\n",
        "    for min_lag, max_lag in lag_specifications:\n",
        "        print(f\"\\nAnalyzing lag specification: {min_lag}-{max_lag} years\")\n",
        "\n",
        "        # Run for all sectors\n",
        "        results_all = analyzer.run_distributed_lag_model(\n",
        "            min_lag=min_lag,\n",
        "            max_lag=max_lag,\n",
        "            sector='all',\n",
        "            y_var='Tobin_Q',\n",
        "            entity_effects=False,\n",
        "            time_effects=False\n",
        "        )\n",
        "\n",
        "        if results_all:\n",
        "            analyzer.print_model_results(results_all,\n",
        "                                       f\"All Sectors - Lags {min_lag}-{max_lag}\")\n",
        "\n",
        "            if config.CREATE_PLOTS:\n",
        "                fig = analyzer.plot_lag_structure(results_all, min_lag, max_lag)\n",
        "                plt.savefig(os.path.join(config.OUTPUT_DIR,\n",
        "                                       f'lag_structure_all_{min_lag}_{max_lag}.png'),\n",
        "                          dpi=300, bbox_inches='tight')\n",
        "                plt.show()\n",
        "\n",
        "        # Run for Consumer Staples only\n",
        "        results_cs = analyzer.run_distributed_lag_model(\n",
        "            min_lag=min_lag,\n",
        "            max_lag=max_lag,\n",
        "            sector='cs',\n",
        "            y_var='Tobin_Q',\n",
        "            entity_effects=False,\n",
        "            time_effects=False\n",
        "        )\n",
        "\n",
        "        if results_cs:\n",
        "            analyzer.print_model_results(results_cs,\n",
        "                                       f\"Consumer Staples - Lags {min_lag}-{max_lag}\")\n",
        "\n",
        "            if config.CREATE_PLOTS:\n",
        "                fig = analyzer.plot_lag_structure(results_cs, min_lag, max_lag)\n",
        "                plt.savefig(os.path.join(config.OUTPUT_DIR,\n",
        "                                       f'lag_structure_cs_{min_lag}_{max_lag}.png'),\n",
        "                          dpi=300, bbox_inches='tight')\n",
        "                plt.show()\n",
        "\n",
        "        # Run cumulative models\n",
        "        print(f\"\\nCumulative models for lags {min_lag}-{max_lag}\")\n",
        "\n",
        "        cum_all = analyzer.run_cumulative_lag_model(\n",
        "            min_lag=min_lag,\n",
        "            max_lag=max_lag,\n",
        "            sector='all',\n",
        "            y_var='Tobin_Q',\n",
        "            entity_effects=False,\n",
        "            time_effects=False\n",
        "        )\n",
        "\n",
        "        if cum_all:\n",
        "            analyzer.print_model_results(cum_all,\n",
        "                                       f\"Cumulative All Sectors - Lags {min_lag}-{max_lag}\")\n",
        "\n",
        "        cum_cs = analyzer.run_cumulative_lag_model(\n",
        "            min_lag=min_lag,\n",
        "            max_lag=max_lag,\n",
        "            sector='cs',\n",
        "            y_var='Tobin_Q',\n",
        "            entity_effects=False,\n",
        "            time_effects=False\n",
        "        )\n",
        "\n",
        "        if cum_cs:\n",
        "            analyzer.print_model_results(cum_cs,\n",
        "                                       f\"Cumulative Consumer Staples - Lags {min_lag}-{max_lag}\")\n",
        "\n",
        "    # Summarize results\n",
        "    print(\"\\n4. SUMMARIZING RESULTS\")\n",
        "    print(\"-\" * 40)\n",
        "    summarizer = ResultsSummarizer(analyzer)\n",
        "    summarizer.print_comparison()\n",
        "\n",
        "    if config.SAVE_RESULTS:\n",
        "        summarizer.save_results(config.OUTPUT_DIR)\n",
        "\n",
        "    print(\"\\n\" + \"=\"*80)\n",
        "    print(\"ANALYSIS COMPLETE!\")\n",
        "    print(\"=\"*80)\n",
        "    print(f\"\\nModels run: {len(analyzer.results)}\")\n",
        "    print(f\"Output directory: {config.OUTPUT_DIR}\")\n",
        "\n",
        "    return analyzer, summarizer\n",
        "\n",
        "# ============================================================================\n",
        "# EXECUTION\n",
        "# ============================================================================\n",
        "if __name__ == \"__main__\":\n",
        "    # You can easily change the maximum lag here:\n",
        "    config = Config()\n",
        "    config.MAX_LAG = 3  # Change to 2, 3, 4, or 5 as needed\n",
        "\n",
        "    analyzer, summarizer = main()"
      ]
    }
  ]
}